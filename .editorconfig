# keur .editorconfig — follows the same convention as the other
# github.com/rkristelijn projects (helmet, sysinfo, apex-cli, ...):
# 2-space, LF, UTF-8, trim trailing, final newline; tabs only in Makefiles.
#
# NOTE on C/C++ indent: the C++ tree is currently INCONSISTENT — src/rules/ uses
# 2-space, src/keur/ uses 4-space (the hand-formatting drift tracked in TODO).
# A [*.{c,cpp,h}] indent_size is therefore deliberately NOT set here: pinning one
# would fight half the codebase. It is decided together with the .clang-format
# choice (TODO: add .clang-format, reformat once), then added here.
root = true

[*]
indent_style = space
indent_size = 2
end_of_line = lf
charset = utf-8
trim_trailing_whitespace = true
insert_final_newline = true
# In line with .clang-format ColumnLimit: 140 — modern full-HD width, no needless
# wrapping. Editors show the ruler at the same place clang-format will enforce.
max_line_length = 140

[Makefile]
indent_style = tab

[*.{sh,bash}]
indent_style = space
indent_size = 2

# Rule files are a simple key: value / YAML-ish format — 2-space.
[*.rule]
indent_style = space
indent_size = 2

# Markdown: keep trailing-whitespace trimming OFF would break hard line breaks,
# but keur docs do not rely on two-space line breaks, so the global trim stays.
# Line length for docs is governed by the doc linter (rumdl MD013), not the code
# width, so do not impose the 140 ruler on prose here.
[*.md]
indent_size = 2
max_line_length = off
