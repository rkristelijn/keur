id: LEARNED-1789711558-11
title: Potential Sensitive API Key Exposure
category: sast
severity: error
engine: pattern
target:
  extensions: .js .php .rb .py .env .yml .json .ts .go .java .md .txt
patterns:
  - regex: (?i)(api[_-]?key|token|secret|password)\s*[:=]\s*["'][^"']{12,}["']
    message: Sensitive information (API key, token, secret, password) found in the code.
confidence: 0.9
slop: true
