id: LEARNED-1789659690-1
title: Potential Observability Issue in Configuration Files
category: observability
severity: critical
engine: pattern
target:
  extensions: .js .php .rb .py .env .yml .json .ts .go .java .md .txt
patterns:
  - regex: (?i)(db_password|api_key|secret|password)\s*[:=]\s*["'][^"']{12,}["']
    message: This configuration file contains sensitive information such as database passwords or API keys. Ensure that these credentials are not exposed in version control.
confidence: 0.9
slop: true
# composite-candidate: fires on form, not concept; kept for corroboration. from FN:   cpm  observability  cpm-eval/infra/bad-serverless.yml
