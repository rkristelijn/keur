id: LEARNED-1789762336-18
title: Potential Dependency Mismanagement
category: deps
severity: warning
engine: pattern
target:
  extensions: .js .php .rb .py .env .yml .json .ts .go .java .md .txt
patterns:
  - regex: (?i)\b(deps|dependencies|require|import|include|load|use)\s*[:=]\s*["'][^"']{12,}["']
    message: Potential mismanagement of dependencies detected. Ensure all dependencies are properly managed and up-to-date.
confidence: 0.8
