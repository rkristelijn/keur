id: LEARNED-1789712099-2
title: Potential Sensitive API Key Exposure
category: sast
severity: warning
engine: pattern
target:
  extensions: .js .php .rb .py .env .yml .json .ts .go .java .md .txt
patterns:
  - regex: (?i)(api[_-]?key|token|secret|password)\s*[:=]\s*["'][^"']{12,}["']
    message: "Sensitive information (API key/token/secret/password) found in the code. Ensure it is not exposed."
confidence: 0.9
slop: true
