id: literal-classes
title: Literal classification table (noise / magic / identity)
category: quality
engine: pipeline
generic: true
source: keur
ilities: [analysability]
# ADR-058/059/060: a GENERIC rule — it never fires on its own. The literal
# pipeline reads this table by id and routes each extracted literal to a bucket:
#   noise    = ignore (syntax, templates, keywords, prose)
#   magic    = appears >= threshold times -> extract to a constant/enum (rule of three)
#   identity = looks person/system-linked -> belongs in config/vault, not source
# First matching class wins (list order = priority). Override or extend this
# table at repo/global level by id without a rebuild (ADR-059).
stages:
  - extract: literals
  - count: unique
  - classify: { table: literal-classes }
report: by-bucket
classes:
  # --- noise (dropped) : syntax, templates, language keywords ---
  - name: LANG_KEYWORD   bucket: noise     regex: ^(null|true|false|nil|none|undefined)$
  - name: SMALL_NUM      bucket: noise     regex: ^-?[0-9]{1,3}$
  - name: TEMPLATE_VAR   bucket: noise     regex: (^\$)|(%[sd])|(\{\{)|(\}\})
  # --- identity (any frequency) : person/system-linked, externalise ---
  - name: AWS_ARN_KEY    bucket: identity  regex: ^(arn:aws|AROA|AKIA|AIDA)  advice: AWS identifier — belongs in config/IAM, never source
  - name: EMAIL          bucket: identity  regex: @[A-Za-z0-9.-]+\.[A-Za-z]{2,}  advice: email/PII — externalise to config or vault
  - name: URL            bucket: identity  regex: ^https?://  advice: hardcoded endpoint — move to config
  - name: LONG_NUM       bucket: identity  regex: ^[0-9]{6,}$  advice: looks like an id (user/account/ticket) — externalise
  - name: HOSTNAME       bucket: identity  regex: ^[A-Za-z0-9.-]+\.(local|internal|com|co\.uk|net|io|org)$  advice: hostname/domain — move to config
  - name: PATH           bucket: identity  regex: ^(/[A-Za-z]|~/|\./)[\w./-]{3,}  advice: machine-specific path — do not hardcode
  # --- magic (rule of three) : repeated concept -> constant/enum ---
  - name: WORD           bucket: magic     regex: ^[A-Za-z][A-Za-z0-9_-]{1,30}$  threshold: 3  advice: repeated concept — extract to a named constant/enum (drift risk)
