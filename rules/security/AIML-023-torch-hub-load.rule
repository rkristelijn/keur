id: AIML-023
ilities: [modifiability, confidentiality]
source: cpm
maturity: 3
action: warn
title: Unsafe torch.hub.load remote code execution
category: ai-ml
severity: warning
engine: pattern
target:
  extensions: .py .ipynb
  exclude_paths: test/ vendor/ node_modules/ .git/ build/ dist/ __pycache__/ .venv/
  content_contains: torch.hub
patterns:
  - regex: torch\.hub\.load\(
    message: torch.hub.load() downloads and executes remote code
fix: Download models explicitly and load with weights_only=True
