id: FL-SEC-011
ilities: [integrity]
source: cpm
maturity: 2
action: block
title: Flask default/weak SECRET_KEY
category: security
severity: error
engine: pattern
target:
  extensions: .py
  exclude_paths: test/ tests/ vendor/ .git/ build/ venv/ .venv/
  content_contains: SECRET_KEY
patterns:
  - regex: SECRET_KEY\s*=\s*['"](?:dev|development|secret|changeme|change-me|your-secret|default|test|super-secret|keyboard cat)['"]
    message: "Flask SECRET_KEY is a known default — attackers can forge session cookies (CVE-2023-27524)"
  - regex: SECRET_KEY\s*=\s*['"].{1,15}['"]
    message: "Flask SECRET_KEY too short (<16 chars) — brute-forceable, enables session forgery"
fix: "Generate: python -c \"import secrets; print(secrets.token_hex(32))\". Store in environment variable."
