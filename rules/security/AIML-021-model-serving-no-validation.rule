id: AIML-021
ilities: [modifiability, confidentiality]
source: cpm
maturity: 3
action: warn
title: ML inference endpoint without input validation
category: ai-ml
severity: warning
engine: pattern
target:
  extensions: .py .ipynb
  exclude_paths: test/ vendor/ node_modules/ .git/ build/ dist/ __pycache__/ .venv/
  content_contains: predict
patterns:
  - regex: @app\.(route|post|get).*predict|def predict\(
    message: ML inference endpoint — ensure input validation and rate limiting
fix: Add input schema validation, size limits, and authentication
