id: AIML-019
ilities: [modifiability, confidentiality]
source: cpm
maturity: 3
action: warn
title: HuggingFace Hub model download
category: ai-ml
severity: warning
engine: pattern
target:
  extensions: .py .ipynb
  exclude_paths: test/ vendor/ node_modules/ .git/ build/ dist/ __pycache__/ .venv/
  content_contains: hub_download|snapshot_download
patterns:
  - regex: (hf_hub_download|snapshot_download)\(
    message: Downloading model from HuggingFace Hub — verify model provenance
fix: Pin revision hashes, use trust_remote_code=False
