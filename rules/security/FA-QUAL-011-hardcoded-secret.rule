id: FA-QUAL-011
ilities: [integrity]
source: cpm
maturity: 2
action: block
title: FastAPI hardcoded secret key
category: security
severity: error
engine: pattern
target:
  extensions: .py
  exclude_paths: test/ tests/ vendor/ .git/ build/ venv/ .venv/
  content_contains: SECRET
patterns:
  - regex: SECRET_KEY\s*=\s*["'][^"']{1,30}["']
    message: "Hardcoded SECRET_KEY — use environment variable for JWT/session signing keys"
  - regex: secret_key\s*=\s*["'][^"']{1,30}["']
    message: "Hardcoded secret_key — short or hardcoded keys are brute-forceable"
fix: "Load from environment: SECRET_KEY = os.environ['SECRET_KEY'] or use python-decouple/pydantic-settings."
