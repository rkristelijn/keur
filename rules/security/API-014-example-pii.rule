id: API-014
ilities: [integrity]
source: cpm
maturity: 3
action: warn
title: Example values contain PII-like data
category: security
severity: warning
engine: pattern
target:
  extensions: .yaml .yml .json
  exclude_paths: test/ tests/ .git/ vendor/
  content_contains: example
patterns:
  - regex: example:.*(@(gmail|yahoo|hotmail)\.com|\b\d{3}-\d{2}-\d{4}\b|\b\d{3}-\d{3}-\d{4}\b)
    message: "Example value contains PII-like data — use clearly fake examples"
fix: Use obviously fake examples (e.g., user@example.com, 555-000-0000, 000-00-0000) that cannot be confused with real data.
