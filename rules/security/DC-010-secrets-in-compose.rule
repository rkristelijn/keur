id: DC-010
ilities: [integrity]
source: cpm
maturity: 2
action: block
title: Secrets in docker-compose environment
category: security
severity: error
engine: pattern
target:
  filenames: docker-compose.yml docker-compose.yaml docker-compose.dev.yml docker-compose.prod.yml compose.yml compose.yaml
  exclude_paths: .git/
patterns:
  - regex: (PASSWORD|SECRET|TOKEN|API_KEY|PRIVATE_KEY)\s*[:=]\s*['"]?\S{4,}
    message: "Secret value in docker-compose — committed to version control. Use .env file or Docker secrets."
fix: Use .env file with docker-compose (${VAR} syntax) or Docker secrets for production.
