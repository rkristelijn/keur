id: SLS-016
ilities: [integrity]
source: cpm
maturity: 2
action: block
title: Lambda environment secrets
category: security
severity: error
engine: pattern
target:
  extensions: .yaml .yml
  exclude_paths: test/ tests/ .git/ vendor/ node_modules/
  content_contains: Variables
patterns:
  - regex: (SECRET|PASSWORD|TOKEN|API_KEY):\s*["'][A-Za-z0-9+/=_-]{8,}["']
    message: "Secret in Lambda environment variable — use SSM Parameter Store or Secrets Manager"
fix: Store secrets in AWS SSM Parameter Store or Secrets Manager. Reference with !Sub '{{resolve:ssm:/path/to/secret}}' or use serverless-secrets plugin.
