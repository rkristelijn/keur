id: ELS-SEC-002
ilities: [integrity]
source: cpm
maturity: 2
action: block
title: Electron contextIsolation disabled
category: security
severity: error
engine: pattern
target:
  extensions: .ts .js .tsx .jsx
  exclude_paths: test/ tests/ vendor/ node_modules/ .git/ build/ dist/ out/
  content_contains: contextIsolation
patterns:
  - regex: contextIsolation\s*:\s*false
    message: "contextIsolation: false lets renderer scripts tamper with preload/Electron internals (and also disables the process sandbox). It has been the default since Electron 12 — do not turn it off."
fix: "Remove contextIsolation: false (default is true). Communicate with the main world only via contextBridge. See https://www.electronjs.org/docs/latest/tutorial/security#3-enable-context-isolation"
