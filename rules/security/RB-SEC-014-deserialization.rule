id: RB-SEC-014
ilities: [integrity]
source: cpm
maturity: 2
action: block
title: Insecure deserialization and YAML
category: security
severity: error
engine: pattern
target:
  extensions: .rb
  exclude_paths: test/ tests/ spec/
patterns:
  - regex: YAML\.load\(
    message: "YAML.load() can execute arbitrary code — use YAML.safe_load() instead"
  - regex: Marshal\.load\(
    message: "Marshal.load() executes arbitrary code during deserialization — never use with untrusted data"
  - regex: Marshal\.restore\(
    message: "Marshal.restore() has same risks as Marshal.load() — never use with untrusted data"
fix: "Use YAML.safe_load() and JSON.parse() instead of YAML.load() and Marshal"
