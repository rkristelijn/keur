id: GO-SEC-015
ilities: [integrity]
source: cpm
maturity: 3
action: warn
title: Use of unsafe package
category: security
severity: warning
engine: pattern
target:
  extensions: .go
  exclude_paths: test/ vendor/ _test.go
patterns:
  - regex: "unsafe"
    message: Import of unsafe package — bypasses Go memory safety
fix: Avoid unsafe unless absolutely necessary. Document justification if required.
