id: ELS-SEC-006
ilities: [integrity]
source: cpm
maturity: 2
action: block
title: shell.openExternal with dynamic/untrusted input
category: security
severity: error
engine: pattern
target:
  extensions: .ts .js .tsx .jsx
  exclude_paths: test/ tests/ vendor/ node_modules/ .git/ build/ dist/ out/
  content_contains: openExternal
patterns:
  - regex: shell\.openExternal\s*\(\s*[A-Za-z_$][\w$.]*\s*[,)]
    message: "shell.openExternal() with a variable argument — if the URL/path comes from content or a remote source, an attacker can launch arbitrary programs (e.g. file:// or custom-scheme handlers). Validate the protocol against an allowlist first."
fix: "Only pass URLs you have validated (allowlist https:/mailto:). Reject file:// and unknown schemes before calling. To accept a reviewed exception, add `// cpm:ignore ELS-SEC-006 — <reason>`. See https://www.electronjs.org/docs/latest/tutorial/security#15-do-not-use-shellopenexternal-with-untrusted-content"
