id: GQL-006
ilities: [authenticity]
source: cpm
maturity: 3
action: warn
title: GraphQL resolvers without DataLoader (N+1 risk)
category: graphql
severity: warning
engine: absence
target:
  extensions: .ts .js .py .rb .go .java
  exclude_paths: test/ tests/ vendor/ node_modules/ .git/ build/ dist/
  content_contains: resolver
patterns:
  - regex: dataloader\|DataLoader
    message: "GraphQL resolvers without DataLoader — likely N+1 query problem"
fix: Use DataLoader for batching related queries. Install dataloader package and create loaders for each relation to batch database calls per request.
