id: BE-SEC-030
ilities: [integrity]
source: cpm
maturity: 2
action: block
title: SMTP injection / email header injection
category: security
severity: error
engine: pattern
target:
  extensions: .ts .js .py .java .cs .go .rb .php
  exclude_paths: test/ tests/
patterns:
  - regex: (?:mail|sendmail|send_mail|smtp)\(.*(?:req\.|request\.|params|body|query|input)
    message: "User input in email function — SMTP header injection risk (Bcc: injection, spam relay)"
  - regex: Subject:\s*.*(?:\+|concat|format|interpolat).*(?:req|param|input|user|query)
    message: "User input in email Subject — SMTP injection via CRLF (\\r\\n) to add headers"
  - regex: (?:To|From|Cc|Bcc)\s*[:=].*(?:req\.|request\.|params|body|query)
    message: "User input in email header — SMTP injection can redirect or Bcc emails to attacker"
fix: "Validate email addresses strictly (RFC 5321). Strip \\r\\n from all header values. Use email library APIs. CWE-93"
