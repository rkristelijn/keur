id: ELS-SEC-003
ilities: [integrity]
source: cpm
maturity: 2
action: block
title: Electron webSecurity disabled or insecure content allowed
category: security
severity: error
engine: pattern
target:
  extensions: .ts .js .tsx .jsx
  exclude_paths: test/ tests/ vendor/ node_modules/ .git/ build/ dist/ out/
  content_contains: webPreferences
patterns:
  - regex: webSecurity\s*:\s*false
    message: "webSecurity: false disables the same-origin policy and forces allowRunningInsecureContent — it lets code from any origin execute. Never disable it in production."
  - regex: allowRunningInsecureContent\s*:\s*true
    message: "allowRunningInsecureContent: true lets an HTTPS page load and run HTTP scripts/CSS (mixed content), defeating transport security. Remove it."
fix: "Remove webSecurity: false / allowRunningInsecureContent: true (both are secure by default). See https://www.electronjs.org/docs/latest/tutorial/security#6-do-not-disable-websecurity"
