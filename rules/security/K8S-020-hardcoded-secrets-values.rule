id: K8S-020
ilities: [integrity]
source: cpm
maturity: 2
action: block
title: Hardcoded secrets in values.yaml
category: security
severity: error
engine: pattern
target:
  extensions: .yaml .yml
  filenames: values.yaml values.yml
  exclude_paths: test/ tests/ .git/ vendor/
  content_contains: password
patterns:
  - regex: (password|secret|token|apiKey|api_key):\s*["']?[A-Za-z0-9+/=_-]{8,}["']?\s*$
    message: "Hardcoded secret in values.yaml — use sealed-secrets, external-secrets, or Vault"
fix: Use Kubernetes Secrets with sealed-secrets, external-secrets-operator, or HashiCorp Vault. Never commit plaintext credentials.
