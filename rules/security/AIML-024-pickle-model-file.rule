id: AIML-024
ilities: [modifiability, confidentiality]
source: cpm
maturity: 2
action: block
title: Loading pickle-based model files
category: ai-ml
severity: error
engine: pattern
target:
  extensions: .py .ipynb
  exclude_paths: test/ vendor/ node_modules/ .git/ build/ dist/ __pycache__/ .venv/
  content_contains: .pkl|.pickle|.joblib
patterns:
  - regex: (open|load|read).*\.(pkl|pickle|joblib)['"]
    message: Loading serialized model file — pickle-based formats execute arbitrary code
fix: Use safetensors (.safetensors) format instead
