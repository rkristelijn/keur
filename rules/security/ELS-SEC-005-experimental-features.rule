id: ELS-SEC-005
ilities: [integrity]
source: cpm
maturity: 2
action: block
title: Electron experimental / Blink features enabled
category: security
severity: error
engine: pattern
target:
  extensions: .ts .js .tsx .jsx
  exclude_paths: test/ tests/ vendor/ node_modules/ .git/ build/ dist/ out/
  content_contains: webPreferences
patterns:
  - regex: experimentalFeatures\s*:\s*true
    message: "experimentalFeatures: true enables unfinished Chromium features whose impact on Electron is untested — a needless security and stability risk. Remove it unless you know exactly why."
  - regex: enableBlinkFeatures\s*:\s*['"]
    message: "enableBlinkFeatures turns on Blink features disabled by default. Only enable a feature if you know precisely why it is needed and what it exposes."
fix: "Remove experimentalFeatures/enableBlinkFeatures (secure by default). If a specific feature is genuinely required, suppress on that line with `// cpm:ignore ELS-SEC-005 — <reason>`. See https://www.electronjs.org/docs/latest/tutorial/security#9-do-not-enable-experimental-features"
