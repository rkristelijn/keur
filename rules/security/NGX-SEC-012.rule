id: NGX-SEC-012
ilities: [integrity]
source: cpm
maturity: 2
action: block
title: Directory listing enabled
category: security
severity: error
engine: pattern
target:
  extensions: .conf
  exclude_paths: test/ tests/ vendor/ .git/
  content_contains: autoindex
patterns:
  - regex: autoindex\s+on
    message: Directory listing enabled — exposes file structure to attackers
fix: Set autoindex off or remove the directive entirely
