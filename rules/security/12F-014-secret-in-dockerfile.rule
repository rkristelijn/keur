id: 12F-014
ilities: [integrity]
source: cpm
maturity: 3
action: warn
title: Secret in Dockerfile (12-Factor III/V: Config + Build)
category: security
severity: warning
engine: pattern
target:
  filenames: Dockerfile Dockerfile.dev Dockerfile.prod
  exclude_paths: test/ vendor/
  content_contains: FROM
patterns:
  - regex: ^ENV\s+.*(PASSWORD|SECRET|TOKEN|API_KEY|PRIVATE_KEY|CREDENTIALS)\s*=
    message: Secret baked into Dockerfile ENV — use runtime injection
  - regex: ^ARG\s+.*(PASSWORD|SECRET|TOKEN|API_KEY|PRIVATE_KEY)\s*=
    message: Secret in Dockerfile ARG with default value — use build secrets
  - regex: ^COPY\s+\.env\b
    message: Copying .env file into Docker image — inject at runtime
fix: Never bake secrets into images — pass via env vars or secrets manager at runtime (12-Factor III + V)
