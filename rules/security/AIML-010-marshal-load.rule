id: AIML-010
ilities: [modifiability, confidentiality]
source: cpm
maturity: 2
action: block
title: Unsafe marshal deserialization
category: ai-ml
severity: error
engine: pattern
target:
  extensions: .py .ipynb
  exclude_paths: test/ vendor/ node_modules/ .git/ build/ dist/ __pycache__/ .venv/
  content_contains: marshal
patterns:
  - regex: marshal\.(load|loads)\(
    message: marshal.load() can execute arbitrary code via bytecode injection
fix: Use json or struct for binary data
