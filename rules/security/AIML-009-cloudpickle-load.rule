id: AIML-009
ilities: [modifiability, confidentiality]
source: cpm
maturity: 2
action: block
title: Unsafe cloudpickle deserialization
category: ai-ml
severity: error
engine: pattern
target:
  extensions: .py .ipynb
  exclude_paths: test/ vendor/ node_modules/ .git/ build/ dist/ __pycache__/ .venv/
  content_contains: cloudpickle
patterns:
  - regex: cloudpickle\.(load|loads)\(
    message: cloudpickle.load() executes arbitrary code
fix: Use safetensors or json serialization
