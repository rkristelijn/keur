id: HO-SEC-011
ilities: [integrity]
source: cpm
maturity: 2
action: block
title: Hono hardcoded secrets in source
category: security
severity: error
engine: pattern
target:
  extensions: .ts .js .tsx
  exclude_paths: test/ tests/ node_modules/ .git/ build/ dist/
  content_contains: hono
patterns:
  - regex: (JWT_SECRET|API_KEY|SECRET_KEY|AUTH_SECRET)\s*=\s*["'][^"']+["']
    message: "Hardcoded secret in source — use c.env.SECRET_KEY or environment variables"
  - regex: sign\(\s*\{[^}]*\}\s*,\s*["'][^"']+["']
    message: "JWT signed with hardcoded secret — use c.env or Hono bindings for secrets"
fix: "Use Hono environment bindings: const secret = c.env.JWT_SECRET (Cloudflare Workers) or process.env.JWT_SECRET (Node)."
