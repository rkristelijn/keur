id: ELS-SEC-007
ilities: [integrity]
source: cpm
maturity: 2
action: block
title: Electron nodeIntegrationInSubFrames enabled
category: security
severity: error
engine: pattern
target:
  extensions: .ts .js .tsx .jsx
  exclude_paths: test/ tests/ vendor/ node_modules/ .git/ build/ dist/ out/
  content_contains: nodeIntegrationInSubFrames
patterns:
  - regex: nodeIntegrationInSubFrames\s*:\s*true
    message: "nodeIntegrationInSubFrames: true grants Node.js to every iframe/child frame, including remote ones — a broad RCE surface. Leave it off unless you fully control all embedded frames."
fix: "Remove nodeIntegrationInSubFrames: true. Expose capabilities via preload + contextBridge per frame instead. Reviewed exception: `// cpm:ignore ELS-SEC-007 — <reason>`. See https://www.electronjs.org/docs/latest/tutorial/security"
