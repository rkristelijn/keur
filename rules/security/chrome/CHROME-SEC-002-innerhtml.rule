# Chrome extension: assignment to innerHTML/outerHTML (or insertAdjacentHTML)
# is a DOM-XSS sink. In an extension the markup often comes from tab titles,
# URLs or storage — all attacker-influenceable. Prefer textContent.
# WARN not block: sometimes the value is a trusted constant. @see docs/rules-authoring.md
id: CHROME-SEC-002
ilities: [integrity]
maturity: 3
title: Chrome extension assigns to innerHTML/outerHTML (DOM-XSS sink)
category: security
severity: warning
engine: pattern
action: warn
confidence: 0.6
skip_comments: true
target:
  extensions: .js
  exclude_paths: test/ tests/ node_modules/ dist/ vendor/
patterns:
  - regex: \.innerHTML\s*=
    message: "innerHTML assignment — XSS sink if the value is ever attacker-influenced (tab title/URL/storage). Use textContent."
  - regex: \.outerHTML\s*=
    message: "outerHTML assignment — XSS sink. Use textContent or build nodes explicitly."
  - regex: \.insertAdjacentHTML\s*\(
    message: "insertAdjacentHTML — XSS sink. Build DOM nodes instead."
fix: "Use element.textContent for plain text, or create elements with document.createElement."
