id: JV-SEC-014
ilities: [integrity]
source: cpm
maturity: 2
action: block
title: Hardcoded credentials and secrets
category: security
severity: error
engine: pattern
target:
  extensions: .java .kt
  exclude_paths: test/ tests/ target/
patterns:
  - regex: (?:password|passwd|secret|apiKey|api_key)\s*=\s*"[^"]{8,}"
    message: "Hardcoded credential in source code — use environment variables or secrets manager"
  - regex: new\s+(?:UsernamePasswordCredentials|BasicAuth)\s*\(\s*"[^"]+"\s*,\s*"[^"]+"
    message: "Hardcoded username/password in credential constructor — externalize to config"
fix: "Use environment variables, Spring Vault, or AWS Secrets Manager"
