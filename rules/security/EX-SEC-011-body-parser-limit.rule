id: EX-SEC-011
ilities: [integrity]
source: cpm
maturity: 3
action: warn
title: Express body-parser without size limit (CVE-2024-45590)
category: security
severity: warning
engine: pattern
skip_comments: true
skip_strings: true
target:
  extensions: .js .ts
  exclude_paths: test/ tests/ vendor/ node_modules/ .git/ build/ dist/
patterns:
  - regex: bodyParser\.json\(\s*\)
    message: "body-parser without limit — CVE-2024-45590 DoS via large payloads. Add limit option."
  - regex: bodyParser\.urlencoded\(\s*\{[^}]*\}
    exclude: limit\s*:
    message: "body-parser urlencoded — verify limit is set to prevent DoS from large form payloads"
  - regex: express\.json\(\s*\)
    message: "express.json() without limit — add {limit: '100kb'} to prevent DoS"
  - regex: express\.json\(\s*\{[^}]*\}\s*\)
    exclude: limit\s*:
    message: "express.json() without a limit option — add {limit: '100kb'} to prevent DoS from large payloads"
  - regex: express\.urlencoded\(\s*\{[^}]*\}\s*\)
    exclude: limit\s*:
    message: "express.urlencoded() without a limit option — add {limit: '100kb'} to prevent DoS"
fix: "Set limits: app.use(express.json({limit: '100kb'})). Add parameterLimit for urlencoded."
