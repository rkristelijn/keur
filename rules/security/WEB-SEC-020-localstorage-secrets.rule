id: WEB-SEC-020
ilities: [integrity]
source: cpm
maturity: 2
action: block
title: Secrets stored in localStorage/sessionStorage
category: security
severity: error
engine: pattern
target:
  extensions: .ts .js .tsx .jsx .vue
  exclude_paths: test/ tests/
patterns:
  - regex: localStorage\.setItem\(\s*["'](?:token|jwt|auth|session|secret|password|api.?key|access.?token)
    message: "Storing auth token/secret in localStorage — accessible to XSS. Use httpOnly cookies instead"
  - regex: sessionStorage\.setItem\(\s*["'](?:token|jwt|auth|session|secret|password|api.?key|access.?token)
    message: "Storing auth token/secret in sessionStorage — accessible to XSS. Use httpOnly cookies"
  - regex: localStorage\[["'](?:token|jwt|auth|secret|password)
    message: "Auth data in localStorage — XSS can steal it. Use httpOnly secure cookies"
fix: "Store auth tokens in httpOnly secure cookies, not in browser storage. CWE-922"
