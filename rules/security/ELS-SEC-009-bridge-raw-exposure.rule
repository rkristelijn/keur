id: ELS-SEC-009
ilities: [integrity]
source: cpm
maturity: 2
action: block
title: contextBridge exposes raw ipcRenderer or Node primitives
category: security
severity: error
engine: pattern
skip_comments: true
target:
  extensions: .ts .js .tsx .jsx
  exclude_paths: test/ tests/ __tests__/ .spec. .test. lib/ vendor/ node_modules/ .git/ build/ dist/ out/
  content_contains: exposeInMainWorld
patterns:
  - regex: exposeInMainWorld\([^,]+,\s*(ipcRenderer|require|process|global|Buffer)\s*\)
    message: "contextBridge exposes a raw powerful object (ipcRenderer/require/process/global/Buffer) to the renderer — this hands untrusted content the whole IPC/Node surface, defeating context isolation. Expose only narrow, purpose-built functions."
fix: "Expose specific wrappers instead: contextBridge.exposeInMainWorld('api', { doX: () => ipcRenderer.invoke('x') }). Never pass ipcRenderer/require/process directly. See https://www.electronjs.org/docs/latest/tutorial/security#20-do-not-expose-electron-apis-to-untrusted-web-content"
