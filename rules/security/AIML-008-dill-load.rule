id: AIML-008
ilities: [modifiability, confidentiality]
source: cpm
maturity: 2
action: block
title: Unsafe dill deserialization
category: ai-ml
severity: error
engine: pattern
target:
  extensions: .py .ipynb
  exclude_paths: test/ vendor/ node_modules/ .git/ build/ dist/ __pycache__/ .venv/
  content_contains: dill
patterns:
  - regex: dill\.(load|loads)\(
    message: dill.load() extends pickle with even more code execution vectors
fix: Avoid dill for untrusted data; use safetensors or protobuf
