id: ELS-SEC-001
ilities: [integrity]
source: cpm
maturity: 2
action: block
title: Electron nodeIntegration enabled in renderer (XSS becomes RCE)
category: security
severity: error
engine: pattern
target:
  extensions: .ts .js .tsx .jsx
  exclude_paths: test/ tests/ vendor/ node_modules/ .git/ build/ dist/ out/
  content_contains: nodeIntegration
patterns:
  - regex: nodeIntegration\s*:\s*true
    message: "nodeIntegration: true gives the renderer full Node.js access — any XSS escalates to Remote Code Execution on the user's machine. Set nodeIntegration: false and expose narrow APIs via a preload + contextBridge."
  - regex: nodeIntegrationInWorker\s*:\s*true
    message: "nodeIntegrationInWorker: true grants Node.js to web workers — same RCE risk as nodeIntegration. Disable it."
fix: "Set nodeIntegration: false (the default). Use a preload script with contextBridge.exposeInMainWorld to expose only the specific functions the renderer needs. See https://www.electronjs.org/docs/latest/tutorial/security#2-do-not-enable-nodejs-integration-for-remote-content"
