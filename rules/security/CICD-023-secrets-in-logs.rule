id: CICD-023
ilities: [integrity]
source: cpm
maturity: 2
action: block
title: CI secrets in logs
category: security
severity: error
engine: pattern
target:
  extensions: .yaml .yml
  filenames: Jenkinsfile
  exclude_paths: test/ tests/ .git/ vendor/ node_modules/
  content_contains: echo
patterns:
  - regex: echo.*\$\{?(SECRET|TOKEN|PASSWORD|API_KEY|CREDENTIALS)
    message: "Secret echoed in CI log — visible in build output to anyone with CI access"
fix: Never echo secrets. Use masked variables (GitLab: masked: true, GitHub: ::add-mask::). For debugging, echo 'SECRET is set' without the value.
