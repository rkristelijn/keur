id: KEUR-SEC-002
maturity: 1
title: Hardcoded secret assigned to a sensitive variable
category: secret
severity: warning
engine: pattern
action: warn
# Learned by the optimiser loop (2026-09-17) against a gitleaks ground truth,
# then reviewed and promoted. Complements KEUR-SEC-001 (private keys): this
# catches generic hardcoded secrets assigned to a key/token/secret/password
# variable, in both `x = "..."` and `x: "..."` styles, with a 12+ char value to
# avoid ordinary short constants.
target:
  extensions: .js .ts .php .rb .py .env .yml .yaml .json .go .java
  exclude_paths: test/ tests/ fixtures/ eval/ .git/
patterns:
  - regex: (?i)(api[_-]?key|token|secret|password)\s*[:=]\s*["'][^"']{12,}["']
    message: "Hardcoded secret assigned to a sensitive variable. Load it from a secret store or environment variable instead."
confidence: 0.8
fix: "Move the value to a secret manager / environment variable and reference it at runtime. If it was ever committed, rotate it."
