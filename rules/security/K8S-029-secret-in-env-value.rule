id: K8S-029
ilities: [integrity]
source: cpm
maturity: 3
action: warn
title: Secret-like env var not using valueFrom
category: security
severity: warning
engine: pattern
target:
  extensions: .yaml .yml
  exclude_paths: test/ tests/ .git/ vendor/
  content_contains: env:
patterns:
  - regex: name:\s*(PASSWORD|SECRET|TOKEN|API_KEY|DATABASE_URL)\s*$
    message: "Secret-like env var — use valueFrom.secretKeyRef instead of hardcoded value"
fix: Store secrets in Kubernetes Secrets and reference them with valueFrom.secretKeyRef. Never inline secret values in manifests.
