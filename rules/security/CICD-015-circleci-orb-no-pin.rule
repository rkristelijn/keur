id: CICD-015
ilities: [integrity]
source: cpm
maturity: 3
action: warn
title: CircleCI orb without version pin
category: supply-chain
severity: warning
engine: pattern
target:
  extensions: .yaml .yml
  filenames: .circleci/config.yml
  exclude_paths: test/ tests/ .git/ vendor/ node_modules/
  content_contains: secret
patterns:
  - regex: :\s*[a-z]+/[a-z-]+@volatile
    message: "CircleCI orb pinned to volatile — pin to exact version for reproducibility"
fix: Pin orbs to exact versions. Example: circleci/node@5.1.0 instead of @volatile. Check orb registry for latest stable version.
