id: ANS-013
ilities: [integrity]
source: cpm
maturity: 2
action: block
title: Hardcoded password in playbook
category: security
severity: error
engine: pattern
target:
  extensions: .yaml .yml
  exclude_paths: test/ tests/ .git/ vendor/ node_modules/
  content_contains: password
patterns:
  - regex: (password|passwd|secret):\s*["']?[A-Za-z0-9@#$%^&*]{8,}["']?
    message: "Hardcoded password in playbook — use ansible-vault or lookup('env', ...)"
fix: Encrypt secrets with ansible-vault encrypt_string. Or use lookup('env', 'MY_SECRET') or lookup('file', '/path/to/secret').
