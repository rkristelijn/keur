id: DK-SEC-011
ilities: [integrity]
source: cpm
maturity: 2
action: block
title: Docker secrets in ARG/ENV/COPY layers
category: security
severity: error
engine: pattern
target:
  filenames: Dockerfile Dockerfile.dev Dockerfile.prod
  exclude_paths: test/ vendor/
patterns:
  - regex: ^ARG\s+\w*(?:PASSWORD|TOKEN|SECRET|KEY|CREDENTIALS|API_KEY)\w*=
    message: "Secret in ARG with default value — visible via 'docker history'. Use --secret mount instead."
  - regex: ^ENV\s+\w*(?:PASSWORD|SECRET|TOKEN|KEY|CREDENTIALS|API_KEY)\w*=
    message: "Secret baked into ENV layer — permanently visible in image history"
  - regex: ^COPY\s+\.env\s
    message: "Copying .env into Docker image — secrets permanently in image layers"
fix: Use Docker BuildKit secrets: RUN --mount=type=secret,id=mysecret. Pass secrets at runtime via env vars.
