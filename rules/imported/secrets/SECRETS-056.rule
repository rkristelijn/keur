id: SECRETS-056
title: Supabase Service Key
category: secrets
severity: error
engine: pattern
target:
  extensions: .ts .tsx .js .jsx .py .java .go .rb .rs .cpp .h .cs .php .env .yml .yaml .json .toml .xml .properties .cfg .ini .conf .sh .tf .hcl
  exclude_paths: test/ vendor/ node_modules/ .git/ build/ dist/ __pycache__/ .venv/ target/
patterns:
  - regex: eyJ[A-Za-z0-9_-]{100,}\.eyJ[A-Za-z0-9_-]{100,}
    message: Supabase service role JWT detected. This key bypasses Row Level Security and grants full database access.
fix: Rotate the key at Supabase Dashboard > Project Settings > API. Never expose service keys in client-side code — use the anon key instead.
