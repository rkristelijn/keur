id: SECRETS-039
title: MongoDB Connection URI with Password
category: secrets
severity: error
engine: pattern
target:
  extensions: .ts .tsx .js .jsx .py .java .go .rb .rs .cpp .h .cs .php .env .yml .yaml .json .toml .xml .properties .cfg .ini .conf .sh .tf .hcl
  exclude_paths: test/ vendor/ node_modules/ .git/ build/ dist/ __pycache__/ .venv/ target/
patterns:
  - regex: mongodb(\+srv)?://[^:]+:[^@]+@
    message: MongoDB connection string with embedded credentials detected. Passwords in URIs are exposed in logs and process listings.
fix: Remove credentials from the connection string. Use environment variables or a secrets manager for the password. Consider MongoDB Atlas database users with scoped roles.
