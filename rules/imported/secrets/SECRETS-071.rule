id: SECRETS-071
title: Pulumi Access Token
category: secrets
severity: error
engine: pattern
target:
  extensions: .ts .tsx .js .jsx .py .java .go .rb .rs .cpp .h .cs .php .env .yml .yaml .json .toml .xml .properties .cfg .ini .conf .sh .tf .hcl
  exclude_paths: test/ vendor/ node_modules/ .git/ build/ dist/ __pycache__/ .venv/ target/
patterns:
  - regex: pul-[a-f0-9]{40}
    message: Pulumi access token detected. This grants access to manage infrastructure stacks and state in Pulumi Cloud.
fix: Revoke the token at Pulumi > Settings > Access Tokens. Create a new token and store it in environment variables or CI/CD secrets.
