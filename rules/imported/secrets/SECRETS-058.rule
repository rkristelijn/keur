id: SECRETS-058
title: Netlify Access Token
category: secrets
severity: error
engine: pattern
target:
  extensions: .ts .tsx .js .jsx .py .java .go .rb .rs .cpp .h .cs .php .env .yml .yaml .json .toml .xml .properties .cfg .ini .conf .sh .tf .hcl
  exclude_paths: test/ vendor/ node_modules/ .git/ build/ dist/ __pycache__/ .venv/ target/
  content_contains: netlify
patterns:
  - regex: [a-f0-9]{40,}
    message: Netlify access token detected. This grants access to deploy and manage Netlify sites and DNS.
fix: Revoke the token at Netlify > User Settings > Applications > Personal Access Tokens. Regenerate and store in CI/CD secrets.
