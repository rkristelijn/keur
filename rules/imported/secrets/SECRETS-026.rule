id: SECRETS-026
title: SendGrid API Key
category: secrets
severity: error
engine: pattern
target:
  extensions: .ts .tsx .js .jsx .py .java .go .rb .rs .cpp .h .cs .php .env .yml .yaml .json .toml .xml .properties .cfg .ini .conf .sh .tf .hcl
  exclude_paths: test/ vendor/ node_modules/ .git/ build/ dist/ __pycache__/ .venv/ target/
patterns:
  - regex: SG\.[A-Za-z0-9_-]{22}\.[A-Za-z0-9_-]{43}
    message: SendGrid API key detected. This can be used to send emails on behalf of your account, enabling phishing or spam.
fix: Delete the key at SendGrid > Settings > API Keys. Create a new key with restricted access and store it in environment variables.
