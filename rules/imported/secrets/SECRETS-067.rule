id: SECRETS-067
title: HashiCorp Terraform Cloud Token
category: secrets
severity: error
engine: pattern
target:
  extensions: .ts .tsx .js .jsx .py .java .go .rb .rs .cpp .h .cs .php .env .yml .yaml .json .toml .xml .properties .cfg .ini .conf .sh .tf .hcl
  exclude_paths: test/ vendor/ node_modules/ .git/ build/ dist/ __pycache__/ .venv/ target/
patterns:
  - regex: [a-zA-Z0-9]{14}\.atlasv1\.[a-zA-Z0-9_-]{60,}
    message: Terraform Cloud/Enterprise API token detected. This grants access to manage infrastructure state, variables, and runs.
fix: Revoke the token at Terraform Cloud > User Settings > Tokens. Use team or organization tokens with minimal permissions.
