id: SECRETS-077
title: Generic Secret Assignment
category: secrets
severity: error
engine: pattern
target:
  extensions: .ts .tsx .js .jsx .py .java .go .rb .rs .cpp .h .cs .php .env .yml .yaml .json .toml .xml .properties .cfg .ini .conf .sh .tf .hcl
  exclude_paths: test/ vendor/ node_modules/ .git/ build/ dist/ __pycache__/ .venv/ target/
patterns:
  - regex: (secret|secret_key|client_secret)\s*[:=]\s*['"][a-zA-Z0-9_-]{16,}['"]
    message: Hardcoded secret assignment detected. Secrets in source code are permanently exposed in version control history.
fix: Move the secret to an environment variable or secrets manager. Use `.env` files (gitignored) for local development and CI/CD variables for deployment.
