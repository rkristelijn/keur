id: SECRETS-065
title: Linear API Key
category: secrets
severity: error
engine: pattern
target:
  extensions: .ts .tsx .js .jsx .py .java .go .rb .rs .cpp .h .cs .php .env .yml .yaml .json .toml .xml .properties .cfg .ini .conf .sh .tf .hcl
  exclude_paths: test/ vendor/ node_modules/ .git/ build/ dist/ __pycache__/ .venv/ target/
patterns:
  - regex: lin_api_[a-zA-Z0-9]{40}
    message: Linear API key detected. This grants access to issues, projects, and team data in Linear.
fix: Revoke the key at Linear > Settings > API > Personal API Keys. Create a new key and store it in environment variables.
