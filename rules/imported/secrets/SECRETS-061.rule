id: SECRETS-061
title: HubSpot API Key
category: secrets
severity: error
engine: pattern
target:
  extensions: .ts .tsx .js .jsx .py .java .go .rb .rs .cpp .h .cs .php .env .yml .yaml .json .toml .xml .properties .cfg .ini .conf .sh .tf .hcl
  exclude_paths: test/ vendor/ node_modules/ .git/ build/ dist/ __pycache__/ .venv/ target/
  content_contains: hubspot
patterns:
  - regex: [a-f0-9]{8}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{12}
    message: HubSpot API key detected. This grants access to CRM data, contacts, deals, and marketing tools.
fix: Deactivate the key at HubSpot > Settings > Integrations > API Key. Migrate to private apps with scoped OAuth tokens.
