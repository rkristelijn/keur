id: SECRETS-018
title: Drone CI Token
category: secrets
severity: error
engine: pattern
target:
  extensions: .ts .tsx .js .jsx .py .java .go .rb .rs .cpp .h .cs .php .env .yml .yaml .json .toml .xml .properties .cfg .ini .conf .sh .tf .hcl
  exclude_paths: test/ vendor/ node_modules/ .git/ build/ dist/ __pycache__/ .venv/ target/
  content_contains: DRONE
patterns:
  - regex: DRONE_[A-Z_]*TOKEN\s*=\s*['"]?[a-zA-Z0-9_-]{20,}
    message: Drone CI token detected in environment variable assignment. This grants access to Drone CI APIs.
fix: Remove the hardcoded token and use Drone secrets management (`drone secret add`). Never store CI tokens in source code.
