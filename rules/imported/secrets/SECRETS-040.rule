id: SECRETS-040
title: PostgreSQL URI with Password
category: secrets
severity: error
engine: pattern
target:
  extensions: .ts .tsx .js .jsx .py .java .go .rb .rs .cpp .h .cs .php .env .yml .yaml .json .toml .xml .properties .cfg .ini .conf .sh .tf .hcl
  exclude_paths: test/ vendor/ node_modules/ .git/ build/ dist/ __pycache__/ .venv/ target/
patterns:
  - regex: postgres(ql)?://[^:]+:[^@]+@
    message: PostgreSQL connection string with embedded credentials detected. Credentials in URIs leak via logs, ps output, and error messages.
fix: Use environment variables (e.g., PGPASSWORD, DATABASE_URL) loaded from a secrets manager. Use .pgpass file for local development.
