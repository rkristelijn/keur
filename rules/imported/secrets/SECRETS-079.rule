id: SECRETS-079
title: Generic Private Key (DSA/OPENSSH/PGP)
category: secrets
severity: error
engine: pattern
target:
  extensions: .ts .tsx .js .jsx .py .java .go .rb .rs .cpp .h .cs .php .env .yml .yaml .json .toml .xml .properties .cfg .ini .conf .sh .tf .hcl .pem .key
  exclude_paths: test/ vendor/ node_modules/ .git/ build/ dist/ __pycache__/ .venv/ target/
patterns:
  - regex: -----BEGIN (DSA|OPENSSH|PGP) PRIVATE KEY
    message: Private key (DSA, OpenSSH, or PGP) detected in source code. Private keys must never be committed — they grant authentication or decryption access.
fix: Remove the key from the repository and rotate it immediately. Use SSH agent forwarding, GPG agent, or a secrets manager. Run `git filter-repo` to scrub from history.
