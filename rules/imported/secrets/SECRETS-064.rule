id: SECRETS-064
title: Atlassian API Token
category: secrets
severity: error
engine: pattern
target:
  extensions: .ts .tsx .js .jsx .py .java .go .rb .rs .cpp .h .cs .php .env .yml .yaml .json .toml .xml .properties .cfg .ini .conf .sh .tf .hcl
  exclude_paths: test/ vendor/ node_modules/ .git/ build/ dist/ __pycache__/ .venv/ target/
  content_contains: atlassian
patterns:
  - regex: [A-Za-z0-9]{24}
    message: Atlassian API token detected. This grants access to Jira, Confluence, and other Atlassian products.
fix: Revoke the token at Atlassian > Account Settings > Security > API Tokens. Create a new token and store it in environment variables.
