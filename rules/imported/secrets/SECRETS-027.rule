id: SECRETS-027
title: Mailgun API Key
category: secrets
severity: error
engine: pattern
target:
  extensions: .ts .tsx .js .jsx .py .java .go .rb .rs .cpp .h .cs .php .env .yml .yaml .json .toml .xml .properties .cfg .ini .conf .sh .tf .hcl
  exclude_paths: test/ vendor/ node_modules/ .git/ build/ dist/ __pycache__/ .venv/ target/
patterns:
  - regex: key-[0-9a-zA-Z]{32}
    message: Mailgun API key detected. This grants access to send emails and manage your Mailgun domain.
fix: Rotate the key at Mailgun > Settings > API Security. Use domain-scoped sending keys with minimal permissions.
