id: SECRETS-031
title: Stripe Restricted API Key
category: secrets
severity: error
engine: pattern
target:
  extensions: .ts .tsx .js .jsx .py .java .go .rb .rs .cpp .h .cs .php .env .yml .yaml .json .toml .xml .properties .cfg .ini .conf .sh .tf .hcl
  exclude_paths: test/ vendor/ node_modules/ .git/ build/ dist/ __pycache__/ .venv/ target/
patterns:
  - regex: rk_live_[a-zA-Z0-9]{24,}
    message: Stripe restricted live API key detected. This grants limited but real access to your Stripe account in production.
fix: Delete the key at Stripe Dashboard > Developers > API Keys. Create a new restricted key with minimal permissions and store in environment variables.
