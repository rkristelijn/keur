id: SECRETS-030
title: Microsoft Teams Webhook
category: secrets
severity: error
engine: pattern
target:
  extensions: .ts .tsx .js .jsx .py .java .go .rb .rs .cpp .h .cs .php .env .yml .yaml .json .toml .xml .properties .cfg .ini .conf .sh .tf .hcl
  exclude_paths: test/ vendor/ node_modules/ .git/ build/ dist/ __pycache__/ .venv/ target/
patterns:
  - regex: outlook\.office\.com/webhook/[a-zA-Z0-9@._-]+
    message: Microsoft Teams incoming webhook URL detected. Anyone with this URL can post messages to your Teams channel.
fix: Delete the webhook in Teams > Channel > Connectors. Create a new webhook and store the URL in environment variables or a secrets manager.
