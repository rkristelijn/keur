id: SECRETS-003
title: GCP Service Account JSON Key
category: secrets
severity: error
engine: pattern
target:
  extensions: .ts .tsx .js .jsx .py .java .go .rb .rs .cpp .h .cs .php .env .yml .yaml .json .toml .xml .properties .cfg .ini .conf .sh .tf .hcl
  exclude_paths: test/ vendor/ node_modules/ .git/ build/ dist/ __pycache__/ .venv/ target/
patterns:
  - regex: "private_key"\s*:\s*"-----BEGIN
    message: GCP service account private key detected in JSON. This grants full access to the service account's permissions.
fix: Delete the key in GCP Console > IAM > Service Accounts > Keys. Use Workload Identity Federation or instance-attached service accounts instead.
