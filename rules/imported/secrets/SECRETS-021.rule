id: SECRETS-021
title: Discord Bot Token
category: secrets
severity: error
engine: pattern
target:
  extensions: .ts .tsx .js .jsx .py .java .go .rb .rs .cpp .h .cs .php .env .yml .yaml .json .toml .xml .properties .cfg .ini .conf .sh .tf .hcl
  exclude_paths: test/ vendor/ node_modules/ .git/ build/ dist/ __pycache__/ .venv/ target/
patterns:
  - regex: [MN][A-Za-z0-9]{23,}\.[A-Za-z0-9_-]{6}\.[A-Za-z0-9_-]{27,}
    message: Discord bot token detected. This grants full control over a Discord bot, including reading messages and managing servers.
fix: Regenerate the token at Discord Developer Portal > Bot > Reset Token. Use environment variables and never commit bot tokens.
