id: SECRETS-069
title: Age Secret Key
category: secrets
severity: error
engine: pattern
target:
  extensions: .ts .tsx .js .jsx .py .java .go .rb .rs .cpp .h .cs .php .env .yml .yaml .json .toml .xml .properties .cfg .ini .conf .sh .tf .hcl
  exclude_paths: test/ vendor/ node_modules/ .git/ build/ dist/ __pycache__/ .venv/ target/
patterns:
  - regex: AGE-SECRET-KEY-1[QPZRY9X8GF2TVDW0S3JN54KHCE6MUA7L]{58}
    message: Age encryption secret key detected. This can decrypt all files encrypted with the corresponding public key.
fix: Generate a new key pair with `age-keygen`. Re-encrypt all files with the new public key and securely delete the old private key from the repository.
