id: SECRETS-072
title: Grafana API Key
category: secrets
severity: error
engine: pattern
target:
  extensions: .ts .tsx .js .jsx .py .java .go .rb .rs .cpp .h .cs .php .env .yml .yaml .json .toml .xml .properties .cfg .ini .conf .sh .tf .hcl
  exclude_paths: test/ vendor/ node_modules/ .git/ build/ dist/ __pycache__/ .venv/ target/
patterns:
  - regex: eyJr[a-zA-Z0-9_-]+\.[a-zA-Z0-9_-]+\.[a-zA-Z0-9_-]+
    message: Grafana API key (JWT) detected. This grants access to dashboards, data sources, and alerting configurations.
fix: Delete the API key at Grafana > Configuration > API Keys. Migrate to Grafana service accounts with scoped tokens and minimal roles.
