id: SECRETS-047
title: New Relic API Key
category: secrets
severity: error
engine: pattern
target:
  extensions: .ts .tsx .js .jsx .py .java .go .rb .rs .cpp .h .cs .php .env .yml .yaml .json .toml .xml .properties .cfg .ini .conf .sh .tf .hcl
  exclude_paths: test/ vendor/ node_modules/ .git/ build/ dist/ __pycache__/ .venv/ target/
patterns:
  - regex: NRAK-[A-Z0-9]{27}
    message: New Relic API key detected. This grants access to New Relic monitoring data and configuration.
fix: Delete the key at New Relic > API Keys. Create a new key with minimal permissions and store it in environment variables.
