id: SECRETS-043
title: AMQP URI with Password
category: secrets
severity: error
engine: pattern
target:
  extensions: .ts .tsx .js .jsx .py .java .go .rb .rs .cpp .h .cs .php .env .yml .yaml .json .toml .xml .properties .cfg .ini .conf .sh .tf .hcl
  exclude_paths: test/ vendor/ node_modules/ .git/ build/ dist/ __pycache__/ .venv/ target/
patterns:
  - regex: amqps?://[^:]+:[^@]+@
    message: AMQP (RabbitMQ) connection string with embedded credentials detected. Credentials in URIs leak via logs and error messages.
fix: Use environment variables for AMQP credentials. Store the password in a secrets manager and construct the URI at runtime.
