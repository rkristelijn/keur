id: SECRETS-008
title: IBM Cloud API Key
category: secrets
severity: error
engine: pattern
target:
  extensions: .ts .tsx .js .jsx .py .java .go .rb .rs .cpp .h .cs .php .env .yml .yaml .json .toml .xml .properties .cfg .ini .conf .sh .tf .hcl
  exclude_paths: test/ vendor/ node_modules/ .git/ build/ dist/ __pycache__/ .venv/ target/
patterns:
  - regex: ibm_cloud_iam_api_key\s*=\s*[A-Za-z0-9_-]{44}
    message: IBM Cloud IAM API key detected. This grants access to IBM Cloud services.
fix: Delete the API key in IBM Cloud Console > Manage > IAM > API Keys. Use service IDs with minimal permissions and store keys in IBM Key Protect.
