id: SECRETS-017
title: Jenkins API Token
category: secrets
severity: error
engine: pattern
target:
  extensions: .ts .tsx .js .jsx .py .java .go .rb .rs .cpp .h .cs .php .env .yml .yaml .json .toml .xml .properties .cfg .ini .conf .sh .tf .hcl
  exclude_paths: test/ vendor/ node_modules/ .git/ build/ dist/ __pycache__/ .venv/ target/
  content_contains: jenkins
patterns:
  - regex: [0-9a-f]{32,34}
    message: Jenkins API token detected. This can be used to trigger builds and access Jenkins remotely.
fix: Revoke the token in Jenkins > User > Configure > API Token. Use Jenkins credential store for secrets and restrict API access.
