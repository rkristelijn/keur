id: SECRETS-032
title: Square Access Token
category: secrets
severity: error
engine: pattern
target:
  extensions: .ts .tsx .js .jsx .py .java .go .rb .rs .cpp .h .cs .php .env .yml .yaml .json .toml .xml .properties .cfg .ini .conf .sh .tf .hcl
  exclude_paths: test/ vendor/ node_modules/ .git/ build/ dist/ __pycache__/ .venv/ target/
patterns:
  - regex: sq0atp-[a-zA-Z0-9_-]{22,}
    message: Square access token detected. This grants access to payment processing and merchant data.
fix: Revoke the token in Square Developer Dashboard > OAuth. Generate a new token and store it in a secrets manager.
