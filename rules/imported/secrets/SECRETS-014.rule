id: SECRETS-014
title: Bitbucket App Password
category: secrets
severity: error
engine: pattern
target:
  extensions: .ts .tsx .js .jsx .py .java .go .rb .rs .cpp .h .cs .php .env .yml .yaml .json .toml .xml .properties .cfg .ini .conf .sh .tf .hcl
  exclude_paths: test/ vendor/ node_modules/ .git/ build/ dist/ __pycache__/ .venv/ target/
patterns:
  - regex: ATBB[A-Za-z0-9]{32,}
    message: Bitbucket app password detected. This grants access to Bitbucket repositories and APIs.
fix: Revoke the app password at Bitbucket > Personal Settings > App Passwords. Create a new one with minimal permissions and use environment variables.
