id: SECRETS-048
title: New Relic License Key
category: secrets
severity: error
engine: pattern
target:
  extensions: .ts .tsx .js .jsx .py .java .go .rb .rs .cpp .h .cs .php .env .yml .yaml .json .toml .xml .properties .cfg .ini .conf .sh .tf .hcl
  exclude_paths: test/ vendor/ node_modules/ .git/ build/ dist/ __pycache__/ .venv/ target/
  content_contains: newrelic
patterns:
  - regex: [a-f0-9]{40}NRAL
    message: New Relic license key detected. This allows agents to report data to your New Relic account.
fix: Rotate the license key at New Relic > Account Settings. Store the new key in environment variables and redeploy agents.
