id: SECRETS-035
title: Shopify Access Token
category: secrets
severity: error
engine: pattern
target:
  extensions: .ts .tsx .js .jsx .py .java .go .rb .rs .cpp .h .cs .php .env .yml .yaml .json .toml .xml .properties .cfg .ini .conf .sh .tf .hcl
  exclude_paths: test/ vendor/ node_modules/ .git/ build/ dist/ __pycache__/ .venv/ target/
patterns:
  - regex: shpat_[a-fA-F0-9]{32}
    message: Shopify admin API access token detected. This grants access to store data, orders, and customer information.
fix: Revoke the token in Shopify Admin > Apps > Develop Apps. Regenerate with minimal scopes and store in environment variables.
