id: SECRETS-010
title: Vultr API Key
category: secrets
severity: error
engine: pattern
target:
  extensions: .ts .tsx .js .jsx .py .java .go .rb .rs .cpp .h .cs .php .env .yml .yaml .json .toml .xml .properties .cfg .ini .conf .sh .tf .hcl
  exclude_paths: test/ vendor/ node_modules/ .git/ build/ dist/ __pycache__/ .venv/ target/
  content_contains: VULTR
patterns:
  - regex: VULTR_API_KEY\s*[=:]\s*['"]?[A-Z0-9]{36}
    message: Vultr API key detected. This grants full access to your Vultr account and infrastructure.
fix: Regenerate the API key at Vultr > Account > API. Use environment variables and restrict API access by IP address.
