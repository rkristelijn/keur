id: SECRETS-028
title: Mailchimp API Key
category: secrets
severity: error
engine: pattern
target:
  extensions: .ts .tsx .js .jsx .py .java .go .rb .rs .cpp .h .cs .php .env .yml .yaml .json .toml .xml .properties .cfg .ini .conf .sh .tf .hcl
  exclude_paths: test/ vendor/ node_modules/ .git/ build/ dist/ __pycache__/ .venv/ target/
patterns:
  - regex: [0-9a-f]{32}-us[0-9]{1,2}
    message: Mailchimp API key detected. This grants access to mailing lists, campaigns, and subscriber data.
fix: Regenerate the key at Mailchimp > Account > Extras > API Keys. Store the new key in environment variables or a secrets manager.
