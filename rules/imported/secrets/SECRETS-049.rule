id: SECRETS-049
title: PagerDuty API Key
category: secrets
severity: error
engine: pattern
target:
  extensions: .ts .tsx .js .jsx .py .java .go .rb .rs .cpp .h .cs .php .env .yml .yaml .json .toml .xml .properties .cfg .ini .conf .sh .tf .hcl
  exclude_paths: test/ vendor/ node_modules/ .git/ build/ dist/ __pycache__/ .venv/ target/
  content_contains: pagerduty
patterns:
  - regex: [a-zA-Z0-9+/]{20,}=*
    message: PagerDuty API key detected. This can be used to manage incidents, services, and on-call schedules.
fix: Revoke the key at PagerDuty > Integrations > API Access Keys. Create a new read-only key if possible and store in environment variables.
