id: SCA-053
title: Suspicious yarn.lock with non-standard registry URL
category: supply-chain
severity: warning
engine: pattern
target:
  filenames: yarn.lock
  exclude_paths: test/ node_modules/ .git/ vendor/
patterns:
  - regex: resolved\s+"https?://
    message: Verify resolved URL points to registry.yarnpkg.com or registry.npmjs.org. Tampered yarn.lock can redirect downloads to non-standard registry.
fix: Regenerate yarn.lock with yarn install --frozen-lockfile. Audit any non-standard registry URLs.
