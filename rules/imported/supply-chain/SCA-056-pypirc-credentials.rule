id: SCA-056
title: Committed .pypirc with committed credentials
category: supply-chain
severity: error
engine: pattern
target:
  filenames: .pypirc
  exclude_paths: test/ node_modules/ .git/ vendor/
patterns:
  - regex: (password|token)\s*=\s*\S+
    message: Committed .pypirc exposes PyPI upload credentials — attackers can publish trojanized packages to your account.
fix: Never commit .pypirc. Use TWINE_PASSWORD environment variable or API tokens with minimal scope.
