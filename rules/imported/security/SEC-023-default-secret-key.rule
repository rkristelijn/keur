id: SEC-023
title: Framework default/placeholder secret key (CVE-2023-27524)
category: security
severity: error
engine: pattern
target:
  extensions: .py .rb .js .ts .env
  exclude_paths: test/ tests/ vendor/ node_modules/ .git/ build/ dist/
patterns:
  - regex: SECRET_KEY\s*=\s*['"](?:changeme|change-me|secret|your-secret|please-change|default|test|thisISaSECRET|CHANGE_THIS|supersecret|keyboard cat|development_secret)['"]
    message: "Default/placeholder secret key — attackers can forge session cookies (CVE-2023-27524: Superset admin takeover)"
  - regex: secret_key_base\s*[=:]\s*['"][a-f0-9]{10,30}['"]
    message: "Short secret_key_base — brute-forceable, enables session forgery"
fix: Generate a cryptographically random key >= 32 bytes. Store in env var or secrets manager.