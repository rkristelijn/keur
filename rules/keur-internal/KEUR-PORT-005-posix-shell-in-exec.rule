# keur portability control — adapted from cpm STYLE-017 (@see cpm ADR-170).
# POSIX shell commands baked into system()/popen() build fine on Windows but
# fail at runtime under cmd (no `mkdir -p`, `command -v`, `rm -rf`, `chmod`).
# Route filesystem/process ops through keur::platform. @see docs/adr/ADR-005.
#
# Only genuine POSIX-shell artifacts (the git-hook stub strings, which git runs
# via sh even on Windows) may remain — those live in cmd/hook.cpp as string
# literals, not inside system()/popen(), so they do not match these patterns.
id: KEUR-PORT-005
title: Hardcoded POSIX shell command in system()/popen()
category: architecture
severity: error
engine: pattern
action: block
target:
  extensions: .c .cpp .cc
  exclude_paths: common/ vendor/ ../rules/ _test.cpp test/ tests/ build/ dist/
patterns:
  - regex: (system|popen)\s*\(\s*"[^"]*\bmkdir -p\b
    message: "Hardcoded 'mkdir -p' in a shell command — breaks on Windows cmd. Use keur::platform::make_dir() (ADR-005)"
  - regex: (system|popen)\s*\(\s*"[^"]*\brm -rf\b
    message: "Hardcoded 'rm -rf' in a shell command — not portable to Windows cmd. Route through the platform layer (ADR-005)"
  - regex: (system|popen)\s*\(\s*"[^"]*\brm -f\b
    message: "Hardcoded 'rm -f' in a shell command — not portable to Windows cmd. Use keur::platform::remove_file() (ADR-005)"
  - regex: (system|popen)\s*\(\s*"[^"]*\bcommand -v\b
    message: "Hardcoded 'command -v' in a shell command — POSIX-only. Use keur::platform::tool_on_path() (ADR-005)"
  - regex: (system|popen)\s*\(\s*"[^"]*\bchmod \+?x\b
    message: "Hardcoded 'chmod +x' in a shell command — no chmod on Windows. Use keur::platform::write_executable() (ADR-005)"
confidence: 0.9
fix: "Filesystem/process operations go through src/keur/common/platform.* (keur::platform::make_dir / remove_file / tool_on_path / write_executable) instead of a hardcoded POSIX shell string. See ADR-005."
