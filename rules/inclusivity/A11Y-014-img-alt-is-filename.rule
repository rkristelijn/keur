id: A11Y-014
ilities: [accessibility]
source: cpm
maturity: 3
action: advisory
title: Image alt text is a filename
category: a11y
severity: warning
engine: pattern
target:
  extensions: .html .htm .jsx .tsx .vue .svelte
  exclude_paths: test/ vendor/ node_modules/ .git/ build/ dist/
  content_contains: alt=
patterns:
  - regex: alt=["'][^"']*\.(jpg|jpeg|png|gif|svg|webp|bmp|ico)["']
    message: "Image alt text is a filename — provide descriptive alt text"
fix: "Replace filename in alt with meaningful description of the image"
