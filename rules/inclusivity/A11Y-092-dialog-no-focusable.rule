id: A11Y-092
ilities: [accessibility]
source: cpm
maturity: 3
action: advisory
title: Dialog-no-focusable
category: a11y
severity: warning
engine: presence
target:
  extensions: .html .htm .jsx .tsx .vue .svelte
  exclude_paths: test/ vendor/ node_modules/ .git/ build/ dist/
  content_contains: role="dialog
patterns:
  - regex: role=["']dialog["']|<dialog
    message: Dialog found — ensure it contains focusable elements
fix: Add at least one button or focusable element inside the dialog
