id: A11Y-057
ilities: [accessibility]
source: cpm
maturity: 3
action: advisory
title: Input type missing
category: a11y
severity: warning
engine: pattern
target:
  extensions: .html .htm .jsx .tsx .vue .svelte
  exclude_paths: test/ vendor/ node_modules/ .git/ build/ dist/
  content_contains: <input
patterns:
  - regex: <input\s*>
    message: <input> without type attribute — defaults to text, be explicit
fix: Add explicit type attribute to <input>.
