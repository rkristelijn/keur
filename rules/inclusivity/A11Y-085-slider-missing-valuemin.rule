id: A11Y-085
ilities: [accessibility]
source: cpm
maturity: 3
action: advisory
title: Slider missing value attributes
category: a11y
severity: warning
engine: presence
target:
  extensions: .html .htm .jsx .tsx .vue .svelte
  exclude_paths: test/ vendor/ node_modules/ .git/ build/ dist/
  content_contains: role="slider
patterns:
  - regex: role=["']slider["']
    message: "Slider found — ensure aria-valuemin, aria-valuemax, aria-valuenow are present"
fix: Add aria-valuemin, aria-valuemax, and aria-valuenow to slider elements.
