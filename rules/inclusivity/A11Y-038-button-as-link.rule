id: A11Y-038
ilities: [accessibility]
source: cpm
maturity: 3
action: advisory
title: Button used as link
category: a11y
severity: warning
engine: pattern
target:
  extensions: .html .htm .jsx .tsx .vue .svelte
  exclude_paths: test/ vendor/ node_modules/ .git/ build/ dist/
  content_contains: window.location
patterns:
  - regex: <button[^>]*>.*window\.location|<button[^>]*on[Cc]lick=[^>]*window\.location
    message: <button> used for navigation — use <a> for links
fix: Replace <button> with <a href="..."> for navigation.
