id: A11Y-076
ilities: [accessibility]
source: cpm
maturity: 3
action: advisory
title: Presentation role with focusable children
category: a11y
severity: warning
engine: presence
target:
  extensions: .html .htm .jsx .tsx .vue .svelte
  exclude_paths: test/ vendor/ node_modules/ .git/ build/ dist/
  content_contains: presentation
patterns:
  - regex: role=["'](presentation|none)["']
    message: "role=presentation/none found — ensure no focusable children"
fix: Verify no buttons, links, or inputs are inside role=presentation elements.
