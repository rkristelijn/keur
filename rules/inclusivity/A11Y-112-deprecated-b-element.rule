id: A11Y-112
ilities: [accessibility]
source: cpm
maturity: 3
action: advisory
title: Deprecated-b-element
category: a11y
severity: warning
engine: pattern
target:
  extensions: .html .htm .jsx .tsx .vue .svelte
  exclude_paths: test/ vendor/ node_modules/ .git/ build/ dist/
  content_contains: <b>
patterns:
  - regex: <b>|<b\s
    message: <b> has no semantic meaning — use <strong> for importance
fix: Replace <b> with <strong> for semantic emphasis
