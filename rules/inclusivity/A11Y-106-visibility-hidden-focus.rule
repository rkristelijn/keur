id: A11Y-106
ilities: [accessibility]
source: cpm
maturity: 3
action: advisory
title: Visibility-hidden-focus
category: a11y
severity: warning
engine: pattern
target:
  extensions: .css .scss .less
  exclude_paths: test/ vendor/ node_modules/ .git/ build/ dist/
  content_contains: :focus
patterns:
  - regex: :focus.*visibility:\s*hidden
    message: Focus state with visibility:hidden — focus indicator not visible
fix: Ensure focus states have visible indicators
