id: A11Y-048
ilities: [accessibility]
source: cpm
maturity: 3
action: advisory
title: Fieldset missing legend
category: a11y
severity: warning
engine: presence
target:
  extensions: .html .htm .jsx .tsx .vue .svelte
  exclude_paths: test/ vendor/ node_modules/ .git/ build/ dist/
  content_contains: <fieldset
patterns:
  - regex: <fieldset
    message: <fieldset> found — ensure it contains a <legend> element
fix: Add <legend> as first child of <fieldset>.
