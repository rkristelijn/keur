id: A11Y-051
ilities: [accessibility]
source: cpm
maturity: 3
action: advisory
title: Textarea missing label
category: a11y
severity: warning
engine: presence
target:
  extensions: .html .htm .jsx .tsx .vue .svelte
  exclude_paths: test/ vendor/ node_modules/ .git/ build/ dist/
  content_contains: <textarea
patterns:
  - regex: <textarea[\s>]
    message: <textarea> found — ensure it has an associated label
fix: Add <label for="id"> or aria-label to <textarea>.
