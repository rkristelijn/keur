id: STYLE-022
ilities: [accessibility]
source: cpm
maturity: 3
action: advisory
title: Non-inclusive terminology (violent/exclusionary/culture)
category: inclusivity
severity: warning
engine: pattern
target:
  extensions: .ts .js .tsx .jsx .py .java .go .cpp .h .rb .cs .sh .md .yml .yaml
  exclude_paths: node_modules/ vendor/ dist/ build/ .git/
patterns:
  - regex: \bwar room\b
    message: war room → use incident room
  - regex: \bkill switch\b
    message: kill switch → use emergency stop
  - regex: \bbus factor\b
    message: bus factor → use lottery factor
  - regex: \bgrandfathered\b
    message: grandfathered → use legacy exempt
  - regex: \btribal knowledge\b
    message: tribal knowledge → use institutional knowledge
  - regex: \bnative speaker\b
    message: native speaker → use fluent speaker
  - regex: \bnormal user\b
    message: normal user → use typical user
  - regex: \bRTFM\b
    message: RTFM → use see documentation
  - regex: \bobviously\b
    message: obviously → remove (dismissive to readers)
  - regex: \bsimply\b
    message: simply → remove (dismissive to readers)
  - regex: \btrivial\b
    message: trivial → use small
  - regex: \bstupid\b
    message: stupid → use incorrect
  - regex: \bdummy\b
    message: dummy → use placeholder
fix: Replace violent, exclusionary, and culturally dismissive terms with inclusive alternatives
