id: A11Y-115
ilities: [accessibility]
source: cpm
maturity: 3
action: advisory
title: Tabindex-on-body
category: a11y
severity: warning
engine: pattern
target:
  extensions: .html .htm
  exclude_paths: test/ vendor/ node_modules/ .git/ build/ dist/
  content_contains: <body
patterns:
  - regex: <body[^>]*tabindex=
    message: tabindex on <body> element — usually unintended
fix: Remove tabindex from <body>
