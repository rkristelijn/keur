id: A11Y-022
ilities: [accessibility]
source: cpm
maturity: 2
action: advisory
title: Icon-only link without accessible text
category: a11y
severity: error
engine: pattern
target:
  extensions: .html .htm .jsx .tsx .vue .svelte
  exclude_paths: test/ vendor/ node_modules/ .git/ build/ dist/
  content_contains: <a
patterns:
  - regex: <a[^>]*>\s*<(i|svg|img|span)[^>]*>[^<]*</(i|svg|img|span)>\s*</a>
    message: "Icon-only link without accessible text — add aria-label"
fix: "Add aria-label or visually-hidden text to icon link"
