id: A11Y-004
ilities: [accessibility]
source: cpm
maturity: 2
action: advisory
title: Viewport disables user scaling
category: a11y
severity: error
engine: pattern
target:
  extensions: .html .htm
  exclude_paths: test/ vendor/ node_modules/ .git/ build/ dist/
  content_contains: user-scalable
patterns:
  - regex: user-scalable\s*=\s*no
    message: "user-scalable=no prevents zooming — violates WCAG 1.4.4"
fix: "Remove user-scalable=no from viewport meta tag"
