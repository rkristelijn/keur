id: A11Y-025
ilities: [accessibility]
source: cpm
maturity: 3
action: advisory
title: Audio element found — ensure transcript provided
category: a11y
severity: warning
engine: presence
target:
  extensions: .html .htm
  exclude_paths: test/ vendor/ node_modules/ .git/ build/ dist/
  content_contains: <audio
patterns:
  - regex: <audio[\s>]
    message: "<audio> element found — ensure transcript is provided"
fix: "Provide a text transcript link near the audio element"
