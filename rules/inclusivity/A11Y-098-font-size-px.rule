id: A11Y-098
ilities: [accessibility]
source: cpm
maturity: 3
action: advisory
title: Font-size-px
category: a11y
severity: warning
engine: pattern
target:
  extensions: .css .scss .less
  exclude_paths: test/ vendor/ node_modules/ .git/ build/ dist/
  content_contains: font-size
patterns:
  - regex: font-size:\s*[0-9]+px
    message: Font size in px — use rem or em for better accessibility
fix: Use relative units (rem, em) instead of px for font sizes
