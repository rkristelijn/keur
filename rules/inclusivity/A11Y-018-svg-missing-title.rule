id: A11Y-018
ilities: [accessibility]
source: cpm
maturity: 3
action: advisory
title: SVG possibly missing accessible name
category: a11y
severity: warning
engine: presence
target:
  extensions: .html .htm .jsx .tsx .vue .svelte
  exclude_paths: test/ vendor/ node_modules/ .git/ build/ dist/
  content_contains: <svg
patterns:
  - regex: <svg[\s>]
    message: "SVG found — ensure it has <title>, aria-label, or aria-labelledby"
fix: "Add <title> as first child of <svg> or use aria-label"
