# @see ADR-166
id: SH-STRICT-001
ilities: [analysability]
source: cpm
maturity: 2
action: advisory
title: Shell script missing shebang line
category: quality
severity: error
engine: absence
scope: 1-1
target:
  extensions: .sh
  exclude_paths: test/ node_modules/ vendor/
patterns:
  - regex: ^#!.*(bash|sh)
    message: "Shell script without shebang line — add #!/usr/bin/env bash as the first line"
fix: Add #!/usr/bin/env bash as the first line of every shell script.
