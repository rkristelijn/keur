id: SH-QUAL-012
ilities: [analysability]
source: cpm
maturity: 3
action: advisory
title: BusyBox/Alpine incompatible shell patterns
category: quality
severity: warning
engine: pattern
target:
  extensions: .sh .bash
  exclude_paths: test/ tests/
patterns:
  - regex: grep\s+--include
    message: "grep --include is not supported in BusyBox/Alpine — use find + grep instead"
  - regex: grep\s+--exclude
    message: "grep --exclude is not supported in BusyBox/Alpine — use find + grep instead"
  - regex: grep\s+-P\b
    message: "grep -P (Perl regex) is not available in BusyBox — use grep -E for extended regex"
  - regex: \bmapfile\b
    message: "mapfile/readarray is bash 4+ only, not available in BusyBox ash — use 'while IFS= read -r'"
  - regex: \breadarray\b
    message: "readarray is bash 4+ only, not available in BusyBox ash — use 'while IFS= read -r'"
  - regex: <<<
    message: "here-string '<<<' is bash-only, not available in BusyBox/Alpine sh — use 'set -- $var', printf | read, or a pipe"
  - regex: \bexport\s+-f\b
    message: "export -f (exporting functions) is bash-only, not in BusyBox/Alpine sh — restructure without exported functions"
  # Only the applets BusyBox installs in /bin (BB_DIR_BIN): grep, sed, cat.
  # sort, awk, cut, find, head, tail, wc, tr and xargs ARE in /usr/bin on
  # BusyBox 1.36 (BB_DIR_USR_BIN), so those paths are valid and not flagged.
  # (sort -V is supported too, with the default FEATURE_SORT_BIG, so no check.)
  - regex: (^|[^v])/usr/bin/(grep|sed|cat)\b
    message: "hardcoded /usr/bin/<tool> path — BusyBox installs grep, sed and cat in /bin, so on Alpine this absolute path fails (exit 127). Use the bare command name (resolved via PATH) or 'command <tool>'"
  - regex: grep\s+-c\b
    message: "grep -c may not be available in all BusyBox builds — use 'grep | wc -l' as fallback"
  - regex: \[\[\s+.*\s+=~\s+
    message: "[[ =~ ]] regex match is bash-only — not available in sh/ash/dash"
fix: "Use POSIX-compatible alternatives for CI/Docker Alpine environments"
