id: ELC-COR-002
ilities: [reliability-maturity]
source: cpm
maturity: 3
action: advisory
title: Deprecated Electron new-window event
category: correctness
severity: warning
engine: pattern
skip_comments: true
target:
  extensions: .ts .js .tsx .jsx
  exclude_paths: test/ tests/ __tests__/ .spec. .test. lib/ vendor/ node_modules/ .git/ build/ dist/ out/
  content_contains: new-window
patterns:
  - regex: \.on\(\s*['"]new-window['"]
    message: "The 'new-window' event was removed in Electron 22 — this handler never fires. Use webContents.setWindowOpenHandler() instead (and default to { action: 'deny' })."
fix: "Replace with setWindowOpenHandler(({ url }) => { /* validate */ return { action: 'deny' } }). See https://www.electronjs.org/docs/latest/api/web-contents#contentssetwindowopenhandlerhandler"
