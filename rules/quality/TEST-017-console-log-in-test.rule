id: TEST-017
ilities: [analysability]
source: cpm
maturity: 4
action: advisory
title: Avoid console.log in test files
category: quality
severity: info
engine: pattern
target:
  extensions: .test.ts .test.js .spec.ts .spec.js .test.tsx .spec.tsx
  exclude_paths: .git/ vendor/ node_modules/
  content_contains: mock
patterns:
  - regex: console\.(log|debug|info)\(
    message: "console.log in test — use test reporter or debug() from testing library"
fix: Remove console.log or use the test framework's built-in reporter. For debugging, use testing-library debug() or --verbose flag.
