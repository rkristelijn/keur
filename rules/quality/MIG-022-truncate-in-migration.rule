id: MIG-022
ilities: [analysability]
source: cpm
maturity: 2
action: advisory
title: TRUNCATE in migration
category: quality
severity: error
engine: pattern
target:
  extensions: .sql
  exclude_paths: test/ tests/ .git/ vendor/ node_modules/ seed/
  content_contains: TRUNCATE
patterns:
  - regex: \bTRUNCATE\b
    message: "TRUNCATE in migration — data loss is permanent and not reversible"
fix: Avoid TRUNCATE in migrations. Use DELETE with WHERE clause if you must remove specific rows, or archive data first.
