id: SLS-011
ilities: [reliability-maturity]
source: cpm
maturity: 3
action: advisory
title: Lambda without timeout
category: reliability
severity: warning
engine: absence
target:
  extensions: .yaml .yml
  filenames: serverless.yml serverless.yaml template.yaml template.yml
  exclude_paths: test/ tests/ .git/ vendor/ node_modules/
  content_contains: handler:
patterns:
  - regex: timeout:
    message: "No timeout set — Lambda defaults to 3s (Serverless) or 3s (SAM), may not be enough"
fix: Add timeout setting. Serverless Framework: timeout: 30 under function. SAM: Timeout: 30 under Properties.
