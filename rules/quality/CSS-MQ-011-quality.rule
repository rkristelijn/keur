id: CSS-MQ-011
ilities: [analysability]
source: cpm
maturity: 4
action: advisory
title: Media query quality
category: quality
severity: info
engine: pattern
target:
  extensions: .css .scss .less
  exclude_paths: node_modules/ vendor/ dist/ build/
patterns:
  - regex: @media\s+screen\s*\{
    message: "@media screen without condition matches all screens — likely missing a width/feature query"
  - regex: @media\s*\(\s*orientation\s*:\s*(portrait|landscape)\s*\)\s*\{
    message: Orientation-only query is unreliable — combine with width for responsive design
  - regex: @media[^{]*(min-width|max-width)\s*:\s*[0-9]+px
    message: px in media queries does not respect user font size — use em for accessible breakpoints
  - regex: @media[^{]*\bhover\s*:\s*hover\b
    message: hover: hover excludes touch devices — provide a fallback for non-hover users
  - regex: @media[^{]*(min|max)-width\s*:\s*([0-9]{1,2}|[12][0-9]{2}|3[01][0-9])px
    message: Breakpoint below 320px targets almost no real devices — verify this is intentional
  - regex: @media[^{]*(min|max)-width\s*:\s*(2[5-9][0-9]{2}|[3-9][0-9]{3}|[0-9]{5,})px
    message: Breakpoint above 2560px targets very few devices — verify this is intentional
  - regex: @media[^{]*\{[^}]*@media
    message: Nested @media queries increase complexity — flatten or use CSS custom media queries
fix: Use em-based breakpoints, combine features in media queries, and avoid deep nesting
