id: MIG-029
ilities: [analysability]
source: cpm
maturity: 3
action: advisory
title: Renaming table/column
category: quality
severity: warning
engine: pattern
target:
  extensions: .sql .rb .py
  exclude_paths: test/ tests/ .git/ vendor/ node_modules/ seed/
  content_contains: RENAME
patterns:
  - regex: (RENAME\s+(TABLE|COLUMN)|rename_table|rename_column|RenameField|RenameModel)
    message: "Renaming table/column — deploy code handling both old and new names first (expand-contract)"
fix: Use expand-contract. Add new column, copy data, update app to use new name, then drop old column in a later migration.
