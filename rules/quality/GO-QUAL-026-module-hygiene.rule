id: GO-QUAL-026
ilities: [analysability]
source: cpm
maturity: 3
action: advisory
title: Module hygiene
category: quality
severity: warning
engine: pattern
target:
  extensions: .mod
  exclude_paths: vendor/
patterns:
  - regex: go 1\.(1[0-9]|[0-9])\b
    message: "Go version <1.20 in go.mod — consider upgrading (1.20+ has better security defaults)"
  - regex: replace\s
    message: "replace directive in go.mod — ensure this is intentional (breaks importability)"
  - regex: \/\/ indirect$
    message: "Indirect dependency — run 'go mod tidy' to verify it's still needed"
fix: Keep go.mod clean with 'go mod tidy'. Upgrade Go version to latest stable.
