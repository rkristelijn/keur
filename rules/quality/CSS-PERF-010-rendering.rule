id: CSS-PERF-010
ilities: [time-behaviour]
source: cpm
maturity: 3
action: advisory
title: Rendering performance
category: performance
severity: warning
engine: pattern
target:
  extensions: .css .scss .less
  exclude_paths: node_modules/ vendor/ dist/ build/
patterns:
  - regex: [a-zA-Z.#\[*][^\{,]*\s+\*\s*[,\{]
    message: Descendant universal selector (*) forces browser to check all children — very expensive
  - regex: @import\s+[^;]*@import
    message: Chained @import blocks parallel loading — use link tags or bundler instead
  - regex: box-shadow\s*:[^;]*(([0-9]{2,}px\s+){2,})
    message: Large box-shadow values are expensive to render — consider simpler alternatives
  - regex: box-shadow\s*:[^;]*,[^;]*,[^;]*,
    message: Multiple box-shadows compound rendering cost — minimize layers or use pseudo-elements
  - regex: backdrop-filter\s*:
    message: backdrop-filter is GPU-intensive — use sparingly and test on low-end devices
  - regex: contain\s*:\s*none
    message: contain: none explicitly disables containment — remove if not needed or use a valid value
  - regex: text-shadow\s*:[^;]*([0-9]{2,}px)
    message: Large text-shadow values are expensive to render on large text blocks
  - regex: transition[^:]*:\s*[^;]*box-shadow
    message: Transitioning box-shadow is expensive — use opacity on a pseudo-element instead
  - regex: transition[^:]*:\s*[^;]*\bfilter\b
    message: Transitioning filter is GPU-intensive — test on low-end devices and limit scope
fix: Avoid descendant * selectors, minimize box-shadow layers, and prefer transform/opacity transitions
