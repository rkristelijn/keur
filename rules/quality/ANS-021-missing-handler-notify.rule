id: ANS-021
ilities: [reliability-maturity]
source: cpm
maturity: 3
action: advisory
title: Missing handler notify
category: reliability
severity: warning
engine: absence
target:
  extensions: .yaml .yml
  exclude_paths: test/ tests/ .git/ vendor/ node_modules/
  content_contains: handlers:
patterns:
  - regex: notify:
    message: "Handlers defined but no tasks notify them — handlers will never run"
fix: Add notify: <handler_name> to tasks that should trigger the handler. Handler names must match exactly between notify and handlers sections.
