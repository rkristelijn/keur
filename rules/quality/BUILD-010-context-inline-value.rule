id: BUILD-010
ilities: [modularity]
source: cpm
maturity: 3
action: advisory
title: Context Provider with inline object literal value
category: build
severity: warning
engine: pattern
target:
  extensions: .tsx .jsx
  exclude_paths: test/ tests/ vendor/ node_modules/ .git/ build/ dist/
  content_contains: Provider
patterns:
  - regex: <\w+Provider\s+value=\{\{
    message: "Context Provider with inline object literal — creates new object reference on every render, causing all consumers to re-render"
fix: Memoize the value object with useMemo — const value = useMemo(() => ({ ... }), [deps]).
