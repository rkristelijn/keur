id: SLS-019
ilities: [reliability-maturity]
source: cpm
maturity: 3
action: advisory
title: Reserved concurrency of 1
category: reliability
severity: warning
engine: pattern
target:
  extensions: .yaml .yml
  filenames: serverless.yml serverless.yaml
  exclude_paths: test/ tests/ .git/ vendor/ node_modules/
  content_contains: reservedConcurrency
patterns:
  - regex: reservedConcurrency:\s*1\b
    message: "reservedConcurrency: 1 limits to single invocation — removes all parallelism"
fix: Increase reservedConcurrency or remove to use unreserved account concurrency. Use provisionedConcurrency for warm starts instead.
