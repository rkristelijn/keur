id: K8S-031
ilities: [reliability-maturity]
source: cpm
maturity: 3
action: advisory
title: Deployment missing readiness probe
category: reliability
severity: warning
engine: absence
target:
  extensions: .yaml .yml
  exclude_paths: test/ tests/ .git/ vendor/
  content_contains: kind: Deployment
patterns:
  - regex: readinessProbe:
    message: "No readinessProbe — traffic is sent to containers before they're ready"
fix: Add readinessProbe to prevent routing traffic to pods that haven't finished initialization.
