id: GO-PATTERN-004
ilities: [reliability]
source: kooiaapi
title: Sentinel error compared with == instead of errors.Is
category: quality
severity: warning
engine: pattern
skip_comments: true
target:
  extensions: .go
  exclude_paths: vendor/
patterns:
  - regex: \berr\s*==\s*[A-Za-z0-9_.]*Err[A-Za-z0-9_]+
    message: "Comparing a wrapped error with == misses wrapped chains — use errors.Is(err, ErrX)."
fix: "Replace err == ErrX with errors.Is(err, ErrX)."
