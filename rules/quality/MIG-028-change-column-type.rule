id: MIG-028
ilities: [analysability]
source: cpm
maturity: 3
action: advisory
title: Changing column type
category: quality
severity: warning
engine: pattern
target:
  extensions: .sql .rb .py
  exclude_paths: test/ tests/ .git/ vendor/ node_modules/ seed/
  content_contains: ALTER
patterns:
  - regex: (ALTER.*TYPE|change_column|AlterField|ChangeColumn)
    message: "Changing column type — may require full table rewrite and can fail if data doesn't fit new type"
fix: Add new column with desired type, migrate data, update application code, then drop old column.
