# keur secrets — a secret assigned on one line and passed to a client/use on a
# nearby line. A single-line regex cannot see this "assign here, use there" shape;
# the multiline engine joins a small window of lines so the pattern can span them
# while staying bounded (no file-wide match). First user of the `multiline` engine.
# @see docs/rules-authoring.md
# @implements ADR-004.stage0
id: KEUR-SEC-009
ilities: [confidentiality]
maturity: 1
title: Hardcoded secret assigned then passed to a client within a few lines
category: secret
severity: warning
engine: multiline
within: window
window: 3
action: warn
confidence: 0.6
skip_comments: true
target:
  extensions: .py .js .ts .go
  exclude_paths: test/ tests/ _test. spec. vendor/ node_modules/
patterns:
  - regex: (?i)(secret|token|api[_-]?key|password)\s*=\s*["'][^"']{12,}["'][\s\S]*?(client|connect|auth|login|request|use)\s*\(
    message: "A hardcoded secret value is assigned and then passed to a client/use within a few lines. Load it from a secret store or environment instead of embedding the literal. (multiline window — spans lines, bounded to the window.)"
fix: "Read the secret from the environment or a secret manager and pass that reference, instead of a literal string near the call site."
