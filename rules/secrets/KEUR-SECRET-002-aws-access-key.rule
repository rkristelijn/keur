id: KEUR-SECRET-002
maturity: 1
title: Hardcoded AWS access key id
category: secret
severity: critical
engine: pattern
action: block
target:
  extensions: .js .py .ts .go .java .rb .php .yml .yaml .env .txt .json
patterns:
  - regex: \bAKIA[0-9A-Z]{16}\b
    message: "Hardcoded AWS access key id (AKIA...) — move it to a secret store and rotate the key."
confidence: 0.98
