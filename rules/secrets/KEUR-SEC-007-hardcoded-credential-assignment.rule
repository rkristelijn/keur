# Promoted from the learning loop (2026-09-19), then reviewed and kept: this
# generalises to a FAMILY of hardcoded-credential assignments rather than a
# single literal. Merges the loop's duplicate secret/quality/iac variants
# (LEARNED-1789653622-4, -1789659500-4, -1789760026-1) into one canonical rule.
# The specific cloud-key names are folded into the key alternation so a
# provider-prefixed key (aws/heroku/private) is still caught.
#
# @implements ADR-079: blocks. At confidence 0.8 it sat below the default block-at (0.85)
# and only ever warned, although it is the one rule that catches
# `AWS_SECRET_ACCESS_KEY = '...'`-style assignments. Measured 2026-11-24 over
# 20 repos: zero hits in committed source; the only hits were in gitignored
# build output. Test, fixture and *.example files are excluded so placeholder
# credentials (`API_KEY=your-api-key-here` in .env.example) do not block; that
# includes co-located tests (*.test.*, *.spec.*, *_test.go, test_*.py).
# Exclusion is a path-substring match.
id: KEUR-SEC-007
ilities: [confidentiality]
maturity: 1
title: Hardcoded credential assigned to a key/secret/token/password
category: secret
severity: critical
engine: pattern
skip_comments: true
target:
  extensions: .js .ts .php .rb .py .go .java .env .yml .yaml .json
  exclude_paths: test/ tests/ __tests__/ spec/ fixtures/ __fixtures__/ testdata/ .test. .spec. _test. _spec. /test_ .example .sample .template node_modules/ vendor/
# The value may not open with a runtime reference (${VAR}, $VAR, {{ secrets.X }},
# #{...}, %{...}): those are injected at runtime, not committed credentials. The
# check is part of the value match (RE2 has no lookahead), so a reference
# elsewhere on the line cannot hide a literal. '$' + digit (bcrypt-style) still
# matches. Each opening alternative is two characters wide, so the minimum value
# length stays 12.
patterns:
  - regex: (?i)\b(?:heroku[_-]?api[_-]?key|aws[_-]?secret[_-]?access[_-]?key|aws[_-]?access[_-]?key[_-]?id|private[_-]?key|api[_-]?key|secret[_-]?key|access[_-]?token|auth[_-]?token|token|secret|password|passwd|pwd)\s*[:=]\s*["'](?:[^"'$#%{][^"']|\$[^"'{A-Za-z_]|\{[^"'{]|[#%][^"'{])[^"']{10,}["']
    message: "Hardcoded credential assigned to a secret-like key (CWE-798). Move it to a secret manager or environment variable injected at runtime; never commit the literal value."
confidence: 0.9
fix: "Do not hardcode credentials. Read them from the environment or a secret manager at runtime. If this value was ever committed, rotate it."
