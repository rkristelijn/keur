id: SCA-036
title: Custom .npmrc registry configuration
category: supply-chain
severity: info
engine: pattern
target:
  filenames: .npmrc
  exclude_paths: test/ node_modules/ .git/ vendor/
patterns:
  - regex: registry\s*=\s*https?://
    message: Custom npm registry configured — creates dependency confusion vector if both private and public registries are active.
fix: If using a private registry, ensure all package scopes are explicitly mapped. Use @scope:registry= for private packages and keep the default registry for public ones.
