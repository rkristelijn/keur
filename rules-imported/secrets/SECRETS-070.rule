id: SECRETS-070
title: 1Password Service Account Token
category: secrets
severity: error
engine: pattern
target:
  extensions: .ts .tsx .js .jsx .py .java .go .rb .rs .cpp .h .cs .php .env .yml .yaml .json .toml .xml .properties .cfg .ini .conf .sh .tf .hcl
  exclude_paths: test/ vendor/ node_modules/ .git/ build/ dist/ __pycache__/ .venv/ target/
patterns:
  - regex: ops_[a-zA-Z0-9_-]{50,}
    message: 1Password service account token detected. This grants programmatic access to vaults and secrets.
fix: Revoke the token at 1Password > Developer Tools > Service Accounts. Create a new token with vault-specific access and store it in CI/CD secrets.
