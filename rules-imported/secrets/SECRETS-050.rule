id: SECRETS-050
title: Sentry DSN
category: secrets
severity: error
engine: pattern
target:
  extensions: .ts .tsx .js .jsx .py .java .go .rb .rs .cpp .h .cs .php .env .yml .yaml .json .toml .xml .properties .cfg .ini .conf .sh .tf .hcl
  exclude_paths: test/ vendor/ node_modules/ .git/ build/ dist/ __pycache__/ .venv/ target/
patterns:
  - regex: https://[a-f0-9]{32}@[a-z0-9]+\.ingest\.sentry\.io/[0-9]+
    message: Sentry DSN with authentication key detected. This allows sending error reports and potentially flooding your Sentry quota.
fix: Rotate the DSN key at Sentry > Project Settings > Client Keys. For client-side apps, use rate limiting and allowed domains.
