id: SECRETS-076
title: Generic API Key Assignment
category: secrets
severity: error
engine: pattern
target:
  extensions: .ts .tsx .js .jsx .py .java .go .rb .rs .cpp .h .cs .php .env .yml .yaml .json .toml .xml .properties .cfg .ini .conf .sh .tf .hcl
  exclude_paths: test/ vendor/ node_modules/ .git/ build/ dist/ __pycache__/ .venv/ target/
patterns:
  - regex: (api_key|apikey|api-key)\s*[:=]\s*['"][a-zA-Z0-9_-]{20,}['"]
    message: Hardcoded API key assignment detected. API keys in source code are exposed in version history and to anyone with repository access.
fix: Move the API key to an environment variable or secrets manager. Reference it via `process.env.API_KEY`, `os.environ['API_KEY']`, or equivalent.
