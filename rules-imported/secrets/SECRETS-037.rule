id: SECRETS-037
title: Shopify Shared Secret
category: secrets
severity: error
engine: pattern
target:
  extensions: .ts .tsx .js .jsx .py .java .go .rb .rs .cpp .h .cs .php .env .yml .yaml .json .toml .xml .properties .cfg .ini .conf .sh .tf .hcl
  exclude_paths: test/ vendor/ node_modules/ .git/ build/ dist/ __pycache__/ .venv/ target/
patterns:
  - regex: shpss_[a-fA-F0-9]{32}
    message: Shopify shared secret detected. This is used to verify webhook authenticity and must remain confidential.
fix: Rotate the shared secret by reinstalling the app. Store the new secret in environment variables and validate webhooks server-side.
