id: SECRETS-044
title: JDBC Connection String with Password
category: secrets
severity: error
engine: pattern
target:
  extensions: .ts .tsx .js .jsx .py .java .go .rb .rs .cpp .h .cs .php .env .yml .yaml .json .toml .xml .properties .cfg .ini .conf .sh .tf .hcl
  exclude_paths: test/ vendor/ node_modules/ .git/ build/ dist/ __pycache__/ .venv/ target/
patterns:
  - regex: jdbc:[a-z]+://.*password=[^&\s]+
    message: JDBC connection string with embedded password parameter detected. Passwords in JDBC URLs are logged by frameworks and connection pools.
fix: Use environment variables or a connection pool configuration that reads credentials from a secrets manager (e.g., Spring Vault, AWS Secrets Manager).
