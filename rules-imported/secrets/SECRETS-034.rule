id: SECRETS-034
title: PayPal Braintree Access Token
category: secrets
severity: error
engine: pattern
target:
  extensions: .ts .tsx .js .jsx .py .java .go .rb .rs .cpp .h .cs .php .env .yml .yaml .json .toml .xml .properties .cfg .ini .conf .sh .tf .hcl
  exclude_paths: test/ vendor/ node_modules/ .git/ build/ dist/ __pycache__/ .venv/ target/
patterns:
  - regex: access_token\$production\$[a-z0-9]{16}\$[a-f0-9]{32}
    message: PayPal/Braintree production access token detected. This grants access to live payment processing.
fix: Regenerate the token in Braintree Control Panel > Settings > API Keys. Store production tokens in a secrets manager with strict access controls.
