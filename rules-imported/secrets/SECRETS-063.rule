id: SECRETS-063
title: Zendesk API Token
category: secrets
severity: error
engine: pattern
target:
  extensions: .ts .tsx .js .jsx .py .java .go .rb .rs .cpp .h .cs .php .env .yml .yaml .json .toml .xml .properties .cfg .ini .conf .sh .tf .hcl
  exclude_paths: test/ vendor/ node_modules/ .git/ build/ dist/ __pycache__/ .venv/ target/
  content_contains: zendesk
patterns:
  - regex: [a-zA-Z0-9]{40}
    message: Zendesk API token detected. This grants access to manage tickets, users, and support operations.
fix: Regenerate the token at Zendesk > Admin > Channels > API. Use OAuth tokens with scoped access when possible.
