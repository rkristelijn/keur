id: SECRETS-016
title: Travis CI Token
category: secrets
severity: error
engine: pattern
target:
  extensions: .ts .tsx .js .jsx .py .java .go .rb .rs .cpp .h .cs .php .env .yml .yaml .json .toml .xml .properties .cfg .ini .conf .sh .tf .hcl
  exclude_paths: test/ vendor/ node_modules/ .git/ build/ dist/ __pycache__/ .venv/ target/
  content_contains: travis
patterns:
  - regex: travis.*['"][a-zA-Z0-9]{20,}['"]
    message: Travis CI token detected. This can be used to access Travis CI APIs and trigger builds.
fix: Regenerate the token at Travis CI > Settings > API authentication. Use encrypted environment variables in .travis.yml instead.
