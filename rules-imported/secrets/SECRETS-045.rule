id: SECRETS-045
title: SQLAlchemy URI with Password
category: secrets
severity: error
engine: pattern
target:
  extensions: .ts .tsx .js .jsx .py .java .go .rb .rs .cpp .h .cs .php .env .yml .yaml .json .toml .xml .properties .cfg .ini .conf .sh .tf .hcl
  exclude_paths: test/ vendor/ node_modules/ .git/ build/ dist/ __pycache__/ .venv/ target/
patterns:
  - regex: (mysql|postgres|sqlite|oracle|mssql).*://[^:]+:[^@]+@
    message: SQLAlchemy-style database URI with embedded credentials detected. Passwords in connection strings are exposed in logs and tracebacks.
fix: Use environment variables for the connection string. In Python, use `os.environ.get('DATABASE_URL')` and store credentials in a secrets manager.
