id: SECRETS-012
title: GitLab Pipeline Token
category: secrets
severity: error
engine: pattern
target:
  extensions: .ts .tsx .js .jsx .py .java .go .rb .rs .cpp .h .cs .php .env .yml .yaml .json .toml .xml .properties .cfg .ini .conf .sh .tf .hcl
  exclude_paths: test/ vendor/ node_modules/ .git/ build/ dist/ __pycache__/ .venv/ target/
patterns:
  - regex: glptt-[a-f0-9]{40,}
    message: GitLab pipeline trigger token detected. This can be used to trigger CI/CD pipelines.
fix: Revoke the token at GitLab > Project Settings > CI/CD > Pipeline Triggers. Regenerate and store in CI/CD variables.
