id: SECRETS-041
title: MySQL URI with Password
category: secrets
severity: error
engine: pattern
target:
  extensions: .ts .tsx .js .jsx .py .java .go .rb .rs .cpp .h .cs .php .env .yml .yaml .json .toml .xml .properties .cfg .ini .conf .sh .tf .hcl
  exclude_paths: test/ vendor/ node_modules/ .git/ build/ dist/ __pycache__/ .venv/ target/
patterns:
  - regex: mysql://[^:]+:[^@]+@
    message: MySQL connection string with embedded credentials detected. Passwords in URIs are visible in logs and process listings.
fix: Use environment variables for database credentials. Store the password in a secrets manager and reference it at runtime.
