id: SECRETS-025
title: Twilio Account SID
category: secrets
severity: error
engine: pattern
target:
  extensions: .ts .tsx .js .jsx .py .java .go .rb .rs .cpp .h .cs .php .env .yml .yaml .json .toml .xml .properties .cfg .ini .conf .sh .tf .hcl
  exclude_paths: test/ vendor/ node_modules/ .git/ build/ dist/ __pycache__/ .venv/ target/
patterns:
  - regex: AC[a-f0-9]{32}
    message: Twilio Account SID detected. Combined with an auth token, this grants full access to your Twilio account.
fix: While the SID itself cannot be changed, ensure it is not committed alongside auth tokens. Store both in environment variables or a secrets manager.
