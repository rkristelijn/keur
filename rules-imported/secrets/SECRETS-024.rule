id: SECRETS-024
title: Twilio API Key
category: secrets
severity: error
engine: pattern
target:
  extensions: .ts .tsx .js .jsx .py .java .go .rb .rs .cpp .h .cs .php .env .yml .yaml .json .toml .xml .properties .cfg .ini .conf .sh .tf .hcl
  exclude_paths: test/ vendor/ node_modules/ .git/ build/ dist/ __pycache__/ .venv/ target/
patterns:
  - regex: SK[0-9a-fA-F]{32}
    message: Twilio API key detected. This can be used to send SMS, make calls, and access Twilio services.
fix: Delete the API key at Twilio Console > API Keys. Create a new key with minimal permissions and store it in environment variables.
