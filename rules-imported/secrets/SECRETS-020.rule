id: SECRETS-020
title: PyPI Token
category: secrets
severity: error
engine: pattern
target:
  extensions: .ts .tsx .js .jsx .py .java .go .rb .rs .cpp .h .cs .php .env .yml .yaml .json .toml .xml .properties .cfg .ini .conf .sh .tf .hcl
  exclude_paths: test/ vendor/ node_modules/ .git/ build/ dist/ __pycache__/ .venv/ target/
patterns:
  - regex: pypi-[A-Za-z0-9_-]{100,}
    message: PyPI API token detected. This can be used to upload packages to the Python Package Index.
fix: Revoke the token at pypi.org > Account Settings > API Tokens. Create a project-scoped token and store it in CI/CD secrets or a keyring.
