id: SECRETS-052
title: Cloudflare API Key
category: secrets
severity: error
engine: pattern
target:
  extensions: .ts .tsx .js .jsx .py .java .go .rb .rs .cpp .h .cs .php .env .yml .yaml .json .toml .xml .properties .cfg .ini .conf .sh .tf .hcl
  exclude_paths: test/ vendor/ node_modules/ .git/ build/ dist/ __pycache__/ .venv/ target/
  content_contains: cloudflare
patterns:
  - regex: [a-f0-9]{37}
    message: Cloudflare API key detected. This grants access to manage DNS, firewall rules, and other Cloudflare services.
fix: Regenerate the key at Cloudflare Dashboard > My Profile > API Tokens. Use scoped API tokens instead of the global key.
