id: SECRETS-005
title: DigitalOcean OAuth Token
category: secrets
severity: error
engine: pattern
target:
  extensions: .ts .tsx .js .jsx .py .java .go .rb .rs .cpp .h .cs .php .env .yml .yaml .json .toml .xml .properties .cfg .ini .conf .sh .tf .hcl
  exclude_paths: test/ vendor/ node_modules/ .git/ build/ dist/ __pycache__/ .venv/ target/
patterns:
  - regex: doo_v1_[a-f0-9]{64}
    message: DigitalOcean OAuth token detected. This grants API access on behalf of a user.
fix: Revoke the OAuth token and regenerate it. Store credentials in environment variables or a secrets manager, never in source code.
