id: SECRETS-075
title: Snyk API Token
category: secrets
severity: error
engine: pattern
target:
  extensions: .ts .tsx .js .jsx .py .java .go .rb .rs .cpp .h .cs .php .env .yml .yaml .json .toml .xml .properties .cfg .ini .conf .sh .tf .hcl
  exclude_paths: test/ vendor/ node_modules/ .git/ build/ dist/ __pycache__/ .venv/ target/
  content_contains: snyk
patterns:
  - regex: SNYK_TOKEN\s*[=:]\s*['"]?[a-f0-9]{8}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{12}
    message: Snyk API token detected. This grants access to vulnerability data, project settings, and organization management.
fix: Revoke the token at Snyk > Account Settings. Generate a new token and store it in environment variables or CI/CD secrets.
