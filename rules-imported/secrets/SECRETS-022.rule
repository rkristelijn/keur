id: SECRETS-022
title: Discord Webhook URL
category: secrets
severity: error
engine: pattern
target:
  extensions: .ts .tsx .js .jsx .py .java .go .rb .rs .cpp .h .cs .php .env .yml .yaml .json .toml .xml .properties .cfg .ini .conf .sh .tf .hcl
  exclude_paths: test/ vendor/ node_modules/ .git/ build/ dist/ __pycache__/ .venv/ target/
patterns:
  - regex: discord\.com/api/webhooks/[0-9]+/[A-Za-z0-9_-]+
    message: Discord webhook URL detected. Anyone with this URL can send messages to your Discord channel.
fix: Delete the webhook in Discord > Server Settings > Integrations > Webhooks. Create a new one and store the URL in environment variables.
