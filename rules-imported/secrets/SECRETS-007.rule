id: SECRETS-007
title: Alibaba Cloud AccessKey
category: secrets
severity: error
engine: pattern
target:
  extensions: .ts .tsx .js .jsx .py .java .go .rb .rs .cpp .h .cs .php .env .yml .yaml .json .toml .xml .properties .cfg .ini .conf .sh .tf .hcl
  exclude_paths: test/ vendor/ node_modules/ .git/ build/ dist/ __pycache__/ .venv/ target/
patterns:
  - regex: LTAI[A-Za-z0-9]{12,20}
    message: Alibaba Cloud AccessKey ID detected. This can be used with the secret to access Alibaba Cloud services.
fix: Disable the AccessKey in Alibaba Cloud Console > AccessKey Management. Use RAM roles or STS tokens for temporary credentials.
