id: SECRETS-013
title: GitLab Runner Registration Token
category: secrets
severity: error
engine: pattern
target:
  extensions: .ts .tsx .js .jsx .py .java .go .rb .rs .cpp .h .cs .php .env .yml .yaml .json .toml .xml .properties .cfg .ini .conf .sh .tf .hcl
  exclude_paths: test/ vendor/ node_modules/ .git/ build/ dist/ __pycache__/ .venv/ target/
patterns:
  - regex: GR1348941[A-Za-z0-9_-]{20,}
    message: GitLab runner registration token detected. This can be used to register rogue CI runners.
fix: Reset the runner token at GitLab > Settings > CI/CD > Runners. Use authentication tokens instead of registration tokens (GitLab 15.10+).
