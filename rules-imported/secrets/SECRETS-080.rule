id: SECRETS-080
title: Bearer Token in Source Code
category: secrets
severity: error
engine: pattern
target:
  extensions: .ts .tsx .js .jsx .py .java .go .rb .rs .cpp .h .cs .php .env .yml .yaml .json .toml .xml .properties .cfg .ini .conf .sh .tf .hcl
  exclude_paths: test/ vendor/ node_modules/ .git/ build/ dist/ __pycache__/ .venv/ target/
patterns:
  - regex: ['"]Bearer\s+[a-zA-Z0-9._-]{20,}['"]
    message: Hardcoded Bearer token detected. Bearer tokens grant direct API access and should never be committed to source code.
fix: Move the token to an environment variable or secrets manager. Load it at runtime and ensure .env files are in .gitignore.
