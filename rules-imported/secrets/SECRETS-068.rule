id: SECRETS-068
title: Doppler Service Token
category: secrets
severity: error
engine: pattern
target:
  extensions: .ts .tsx .js .jsx .py .java .go .rb .rs .cpp .h .cs .php .env .yml .yaml .json .toml .xml .properties .cfg .ini .conf .sh .tf .hcl
  exclude_paths: test/ vendor/ node_modules/ .git/ build/ dist/ __pycache__/ .venv/ target/
patterns:
  - regex: dp\.st\.[a-zA-Z0-9_-]+\.[a-zA-Z0-9]{40,}
    message: Doppler service token detected. This grants access to secrets managed in Doppler for a specific environment.
fix: Revoke the token at Doppler Dashboard > Access. Generate a new service token scoped to the required environment only.
