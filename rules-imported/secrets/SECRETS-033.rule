id: SECRETS-033
title: Square OAuth Secret
category: secrets
severity: error
engine: pattern
target:
  extensions: .ts .tsx .js .jsx .py .java .go .rb .rs .cpp .h .cs .php .env .yml .yaml .json .toml .xml .properties .cfg .ini .conf .sh .tf .hcl
  exclude_paths: test/ vendor/ node_modules/ .git/ build/ dist/ __pycache__/ .venv/ target/
patterns:
  - regex: sq0csp-[a-zA-Z0-9_-]{43,}
    message: Square OAuth client secret detected. This is used to exchange authorization codes for access tokens.
fix: Rotate the secret in Square Developer Dashboard > OAuth. Store the new secret in a secrets manager, not in code.
