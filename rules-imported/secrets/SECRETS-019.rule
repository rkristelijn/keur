id: SECRETS-019
title: Leaked npm token
category: secrets
severity: error
engine: pattern
target:
  extensions: .ts .tsx .js .jsx .py .java .go .rb .rs .cpp .h .cs .php .env .yml .yaml .json .toml .xml .properties .cfg .ini .conf .sh .tf .hcl .npmrc
  exclude_paths: test/ vendor/ node_modules/ .git/ build/ dist/ __pycache__/ .venv/ target/
patterns:
  - regex: npm_[a-zA-Z0-9]{36}
    message: npm access token detected. This can be used to publish packages or access private registries on your behalf.
fix: Revoke the token at npmjs.com > Access Tokens. Use `npm token create --read-only` for CI and store in CI/CD secrets.
