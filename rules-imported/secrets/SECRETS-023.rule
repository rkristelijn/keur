id: SECRETS-023
title: Telegram Bot Token
category: secrets
severity: error
engine: pattern
target:
  extensions: .ts .tsx .js .jsx .py .java .go .rb .rs .cpp .h .cs .php .env .yml .yaml .json .toml .xml .properties .cfg .ini .conf .sh .tf .hcl
  exclude_paths: test/ vendor/ node_modules/ .git/ build/ dist/ __pycache__/ .venv/ target/
patterns:
  - regex: [0-9]{5,}:AA[0-9A-Za-z_-]{33}
    message: Telegram bot token detected. This grants full control over a Telegram bot, including reading and sending messages.
fix: Revoke the token via BotFather (/revoke command). Generate a new token and store it in environment variables or a secrets manager.
