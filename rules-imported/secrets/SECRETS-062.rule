id: SECRETS-062
title: Intercom Access Token
category: secrets
severity: error
engine: pattern
target:
  extensions: .ts .tsx .js .jsx .py .java .go .rb .rs .cpp .h .cs .php .env .yml .yaml .json .toml .xml .properties .cfg .ini .conf .sh .tf .hcl
  exclude_paths: test/ vendor/ node_modules/ .git/ build/ dist/ __pycache__/ .venv/ target/
  content_contains: intercom
patterns:
  - regex: [a-z0-9=]{60}
    message: Intercom access token detected. This grants access to user conversations, contacts, and messaging features.
fix: Regenerate the token at Intercom > Settings > Developers > App. Store it in environment variables or a secrets manager.
