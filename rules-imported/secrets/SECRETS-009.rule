id: SECRETS-009
title: Linode API Token
category: secrets
severity: error
engine: pattern
target:
  extensions: .ts .tsx .js .jsx .py .java .go .rb .rs .cpp .h .cs .php .env .yml .yaml .json .toml .xml .properties .cfg .ini .conf .sh .tf .hcl
  exclude_paths: test/ vendor/ node_modules/ .git/ build/ dist/ __pycache__/ .venv/ target/
patterns:
  - regex: lin_api_[a-zA-Z0-9]{40}
    message: Linode (Akamai) API token detected. This grants access to your Linode infrastructure.
fix: Revoke the token at Linode Cloud Manager > API Tokens. Generate a new token with minimal scopes and store it in a secrets manager.
