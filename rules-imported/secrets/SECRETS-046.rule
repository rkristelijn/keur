id: SECRETS-046
title: Datadog API Key
category: secrets
severity: error
engine: pattern
target:
  extensions: .ts .tsx .js .jsx .py .java .go .rb .rs .cpp .h .cs .php .env .yml .yaml .json .toml .xml .properties .cfg .ini .conf .sh .tf .hcl
  exclude_paths: test/ vendor/ node_modules/ .git/ build/ dist/ __pycache__/ .venv/ target/
patterns:
  - regex: dd[a-z]*_[a-zA-Z0-9]{32,40}
    message: Datadog API or application key detected. This can be used to submit metrics, query data, and manage Datadog configurations.
fix: Revoke the key at Datadog > Organization Settings > API Keys. Create a new key and store it in environment variables or a secrets manager.
