id: SECRETS-053
title: Cloudflare Global API Key
category: secrets
severity: error
engine: pattern
target:
  extensions: .ts .tsx .js .jsx .py .java .go .rb .rs .cpp .h .cs .php .env .yml .yaml .json .toml .xml .properties .cfg .ini .conf .sh .tf .hcl
  exclude_paths: test/ vendor/ node_modules/ .git/ build/ dist/ __pycache__/ .venv/ target/
  content_contains: CF_API_KEY
patterns:
  - regex: [a-z0-9]{37}
    message: Cloudflare Global API key detected. Global keys grant full account access across all zones.
fix: Avoid using global API keys. Create scoped API tokens at Cloudflare Dashboard > My Profile > API Tokens with minimal permissions.
