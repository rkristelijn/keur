id: SECRETS-051
title: Algolia API Key
category: secrets
severity: error
engine: pattern
target:
  extensions: .ts .tsx .js .jsx .py .java .go .rb .rs .cpp .h .cs .php .env .yml .yaml .json .toml .xml .properties .cfg .ini .conf .sh .tf .hcl
  exclude_paths: test/ vendor/ node_modules/ .git/ build/ dist/ __pycache__/ .venv/ target/
  content_contains: algolia
patterns:
  - regex: [a-f0-9]{32}
    message: Algolia API key detected. Admin keys grant full access to indices, including delete operations.
fix: Rotate the key at Algolia Dashboard > API Keys. Use search-only keys for frontend and store admin keys in environment variables server-side.
