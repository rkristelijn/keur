id: SECRETS-078
title: Generic Password Assignment
category: secrets
severity: error
engine: pattern
target:
  extensions: .ts .tsx .js .jsx .py .java .go .rb .rs .cpp .h .cs .php .env .yml .yaml .json .toml .xml .properties .cfg .ini .conf .sh .tf .hcl
  exclude_paths: test/ vendor/ node_modules/ .git/ build/ dist/ __pycache__/ .venv/ target/
patterns:
  - regex: (password|passwd|pwd)\s*[:=]\s*['"][^'"]{8,}['"]
    message: Hardcoded password detected. Passwords in source code are visible to anyone with repository access and persist in git history.
fix: Move the password to an environment variable or secrets manager. Use `.env` files (gitignored) for local development. Never commit real credentials.
