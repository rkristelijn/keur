id: SECRETS-060
title: Contentful Access Token
category: secrets
severity: error
engine: pattern
target:
  extensions: .ts .tsx .js .jsx .py .java .go .rb .rs .cpp .h .cs .php .env .yml .yaml .json .toml .xml .properties .cfg .ini .conf .sh .tf .hcl
  exclude_paths: test/ vendor/ node_modules/ .git/ build/ dist/ __pycache__/ .venv/ target/
  content_contains: contentful
patterns:
  - regex: CFPAT-[A-Za-z0-9_-]{43}
    message: Contentful personal access token detected. This grants read/write access to your Contentful spaces and content.
fix: Revoke the token at Contentful > Settings > API Keys. Create a new token with minimal permissions and store in environment variables.
