id: SECRETS-036
title: Shopify Custom App Token
category: secrets
severity: error
engine: pattern
target:
  extensions: .ts .tsx .js .jsx .py .java .go .rb .rs .cpp .h .cs .php .env .yml .yaml .json .toml .xml .properties .cfg .ini .conf .sh .tf .hcl
  exclude_paths: test/ vendor/ node_modules/ .git/ build/ dist/ __pycache__/ .venv/ target/
patterns:
  - regex: shpca_[a-fA-F0-9]{32}
    message: Shopify custom app access token detected. This grants API access scoped to a specific Shopify store.
fix: Reinstall the custom app to rotate the token. Store the new token in environment variables or a secrets manager.
