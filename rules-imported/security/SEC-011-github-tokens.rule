id: SEC-011b
title: Hardcoded GitHub Token
category: security
severity: error
engine: pattern
target:
  extensions: .ts .js .py .cpp .java .yaml .json .env .sh .md
  exclude_paths: test/ vendor/ node_modules/ .git/
  content_contains: ghp_
patterns:
  - regex: ghp_[a-zA-Z0-9]{36}
    message: GitHub Personal Access Token detected
  - regex: gho_[a-zA-Z0-9]{36}
    message: GitHub OAuth token detected
  - regex: github_pat_[a-zA-Z0-9]{22}_[a-zA-Z0-9]{59}
    message: GitHub fine-grained PAT detected
fix: Use GITHUB_TOKEN environment variable or gh auth
