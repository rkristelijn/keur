#!/usr/bin/env bash
# KEUR pre-push hook (full tier). Installed by `keur hook`.
# Fuller gate (<~30s): secrets + pii + deps + sast + custom rules, optional AI.
set -euo pipefail

BRANCH="$(git rev-parse --abbrev-ref HEAD 2>/dev/null || true)"
if [ "$BRANCH" = "main" ] || [ "$BRANCH" = "master" ]; then
  echo "  ✗ Direct push to $BRANCH blocked (KEUR). Use a feature branch + MR." >&2
  exit 1
fi

if command -v keur >/dev/null 2>&1; then
  keur check --tier pre-push
else
  echo "  ! keur not on PATH — skipping KEUR pre-push checks" >&2
fi
